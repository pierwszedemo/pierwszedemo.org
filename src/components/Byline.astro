---
import { isoDate } from "../collections";
import { FOUNDATION_PATH, type AuthorKey } from "../consts";
import { authorsOf } from "../strony";

/**
 * Podpis pod wpisem w kolumnie „W skrócie”. Wpisy są pisane w pierwszej
 * osobie – podpis z funkcją w fundacji mówi czytelnikowi, czyj to głos,
 * bez przepisywania tekstów na głos organizacji. Przy dwóch autorach każdy
 * dostaje własną linijkę, żeby nazwisko nie odkleiło się od funkcji.
 *
 * `label` ma interlinię 1 – dobrą dla jednej linijki etykiety, ale podpis
 * i data aktualizacji to dwie linie i przy 1 sklejały się w blok.
 *
 * Podpis prowadzi do bio autora na /fundacja – ten sam adres, co `url`
 * węzła Person w JSON-LD, więc czytelnik i robot trafiają w jedno miejsce.
 * `rel="author"` mówi to samo przeglądarce i wyszukiwarce.
 */
interface Props {
  authors: readonly AuthorKey[];
  updated?: Date;
}
const { authors, updated } = Astro.props;
---

<p class="label leading-[1.8] text-muted">
  {
    authorsOf(authors).map((author, index) => (
      <>
        {index > 0 && <br />}
        <a
          href={`${FOUNDATION_PATH}#${author.id}`}
          rel="author"
          class="underline underline-offset-4 transition-colors hover:text-ink"
        >
          {author.name}, {author.role.toLowerCase()}
        </a>
      </>
    ))
  }
  {
    updated && (
      <>
        <br />
        aktualizacja: <time datetime={isoDate(updated)}>{isoDate(updated)}</time>
      </>
    )
  }
</p>
