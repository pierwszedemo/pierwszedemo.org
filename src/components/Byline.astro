---
import { isoDate } from "../collections";
import { type AuthorKey, FOUNDATION_PATH } from "../consts";
import { authorsOf } from "../strony";

/**
 * Podpis pod wpisem w kolumnie „W skrócie”. Wpisy są pisane w pierwszej
 * osobie – podpis mówi czytelnikowi, czyj to głos, bez przepisywania tekstów
 * na głos organizacji. Samo imię i nazwisko, bez funkcji w zarządzie: funkcja
 * brzmiała jak pismo urzędowe, a kto jest kim, mówi bio, do którego prowadzi
 * link. Przy dwóch autorach każdy dostaje własną linijkę.
 *
 * Podpis prowadzi do bio autora na /fundacja – ten sam adres, co `url`
 * węzła Person w JSON-LD, więc czytelnik i robot trafiają w jedno miejsce.
 * `rel="author"` mówi to samo przeglądarce i wyszukiwarce.
 *
 * Każdy link ma linijkę 44 px (cel dotyku z WCAG 2.5.5): przy dwóch autorach
 * w zwykłej interlinii pola dotyku powiększone o `hit` nachodziłyby na siebie.
 */
interface Props {
	authors: readonly AuthorKey[];
	updated?: Date;
}
const { authors, updated } = Astro.props;
---

<p class="text-sm leading-[1.7] text-muted">
  {
    authorsOf(authors).map((author, index) => (
      <>
        {index > 0 && <br />}
        <a
          href={`${FOUNDATION_PATH}#${author.id}`}
          rel="author"
          class="text-link inline-flex min-h-11 items-center font-semibold"
        >
          {author.name}
        </a>
      </>
    ))
  }
  {
    updated && (
      <>
        <br />
        aktualizacja: <time datetime={isoDate(updated)}>{isoDate(updated)}</time>
      </>
    )
  }
</p>
