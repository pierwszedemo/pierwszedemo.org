---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Zdjęcie osoby: zaokrąglona karta z podpisem w pigułce, `object-cover` na
 * całą kartę. Komponent nie wie, kogo pokazuje – zdjęcie, alt i podpis
 * przychodzą w propsach, bo ten sam slot stoi przy obojgu fundatorach na
 * /fundacja.
 *
 * Źródła w src/assets/ są już obrócone zgodnie z EXIF, zmniejszone do
 * najwyżej 1600 px i pozbawione metadanych – oryginały z telefonu niosły tag
 * orientacji i współrzędne GPS. Szerokości są przycięte do źródła: Astro nie
 * powiększa, tylko rzuca błędem.
 */
interface Props {
	src: ImageMetadata;
	alt: string;
	caption: string;
	/** `object-position` – gdzie w kadrze jest twarz przy ciasnym slocie. */
	position?: string;
	loading?: "eager" | "lazy";
	class?: string;
}
const {
	src,
	alt,
	caption,
	position = "object-[center_35%]",
	loading = "lazy",
	class: className,
} = Astro.props;
---

<div class:list={["relative overflow-hidden rounded-[28px] bg-panel", className]}>
  <Image
    src={src}
    alt={alt}
    format="webp"
    widths={[400, 800, 1200].filter((width) => width <= src.width)}
    sizes="(min-width: 768px) 40vw, 100vw"
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    decoding="async"
    class:list={["absolute inset-0 size-full object-cover", position]}
  />
  <p class="absolute bottom-4 left-4 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold">
    {caption}
  </p>
</div>
