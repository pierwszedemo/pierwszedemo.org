---
import { SITE_NAME } from "../consts";

/**
 * Slot na zdjęcie Michała z prawej kolumny hero.
 *
 * Docelowo w miejsce `<div class="…placeholder…">` wchodzi `<Image>` z
 * `astro:assets` (import z `src/assets/`) — reszta komponentu, czyli tło,
 * proporcje i czarny pasek z podpisem, zostaje bez zmian.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["relative bg-panel", className]}>
  <div
    class="label absolute inset-0 flex items-center justify-center px-6 text-center tracking-[0.18em] text-muted"
  >
    Zdjęcie — Michał
  </div>
  <p
    class="label absolute inset-x-0 bottom-0 bg-ink px-6 py-[14px] tracking-[0.18em] text-white"
  >
    {SITE_NAME}
  </p>
</div>
