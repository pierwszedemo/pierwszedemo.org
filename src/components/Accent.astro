---
import { accentParts } from "../typography";

/**
 * Tekst z akcentem `*…*` (patrz `accentParts`). Akcent to wyłącznie kolor
 * z `class` – nagłówki nie mają kursywy, bo wyglądała na przypadkową. Bez
 * `class` gwiazdki po prostu znikają.
 */
interface Props {
	text: string;
	class?: string;
}
const { text, class: className } = Astro.props;
---

{
  accentParts(text).map((part) =>
    part.accent && className ? <em class:list={["not-italic", className]}>{part.text}</em> : part.text,
  )
}
