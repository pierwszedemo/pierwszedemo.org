---
import { NAV, WORDMARK } from "../consts";

interface Props {
	/** Podświetla pozycję w menu – wartość równa NAV[n].label. */
	active?: (typeof NAV)[number]["label"];
}

const { active } = Astro.props;

// Wewnętrzne linie w pasmie są jasne (hairline), samo pasmo zamyka twarda
// linia ink – ta różnica trzyma całą siatkę projektu.
const cell = "px-5 py-4 md:px-8 md:py-[22px]";

// Cztery komórki jak w makiecie: marka i trzy pozycje menu. Kontaktu tu nie ma –
// adres e-mail mieszka w sekcjach „Kontakt" na stronach. Tory 5/3/3/5 z 16
// modułów siatki, nie cztery równe: skrajne komórki mają szerokość kolumny
// bocznej (`--aside`), więc ich linie biegną dalej przez stronę – lewa przez
// „W skrócie" i etykiety sekcji, prawa przez zdjęcie w hero. Na telefonie
// siatka 2×2, stąd liczenie obramowań z indeksu: lewa komórka rzędu dostaje
// border-r, drugi rząd border-t.
---

<nav
  class="grid grid-cols-2 border-b border-ink md:grid-cols-[5fr_3fr_3fr_5fr]"
  aria-label="Główna"
>
  <a
    href="/"
    class={`${cell} border-r border-hairline text-[15px] font-bold tracking-[0.02em]`}
  >
    {WORDMARK}
  </a>
  {
    NAV.map((item, index) => (
      <a
        href={item.href}
        class={`${cell} border-hairline text-sm ${
          index % 2 === 1 ? "border-r" : ""
        } ${index >= 1 ? "border-t" : ""} md:border-t-0 ${
          index < NAV.length - 1 ? "md:border-r" : "md:border-r-0"
        } ${active === item.label ? "font-semibold text-ink" : "text-muted"}`}
        aria-current={active === item.label ? "page" : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>
