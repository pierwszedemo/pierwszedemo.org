---
import { INSTAGRAM_URL } from "../consts";

// Profile osobiste są tylko w schema.org. Widoczna stopka zostawia niezbędne
// minimum: podpis, Instagram marki i równie łatwy jak zgoda dostęp do
// ustawień cookies. Tory 5/3/3/5 jak w nawigacji – te same linie siatki.
const cell = "px-5 py-4 md:py-[19px] lg:px-8";
---

<footer
  class="grid grid-cols-2 border-t border-ink text-[13px] text-muted md:grid-cols-[5fr_3fr_3fr_5fr]"
>
  <div
    class={`${cell} border-r border-b border-hairline md:border-b-0`}
  >
    © {new Date().getFullYear()}
  </div>
  <div
    class={`${cell} border-b border-hairline md:border-r md:border-b-0`}
    aria-hidden="true"
  ></div>
  <a
    href={INSTAGRAM_URL}
    target="_blank"
    rel="noopener"
    class={`${cell} border-r border-hairline underline underline-offset-4 transition-colors hover:text-ink`}
  >
    Instagram
  </a>
  <!-- Panel otwiera delegowany listener w ConsentManager.astro – dzięki temu
       przycisk działa też po podmianie DOM przez ClientRouter. -->
  <button
    type="button"
    data-cc-preferences
    class={`${cell} cursor-pointer text-left underline underline-offset-4 transition-colors hover:text-ink`}
  >
    Cookies
  </button>
</footer>
