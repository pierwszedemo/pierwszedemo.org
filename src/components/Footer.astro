---
import {
	ACCESSIBILITY_PATH,
	FOUNDATION,
	FOUNDATION_PATH,
	INSTAGRAM_URL,
	LOGOTYPE,
	PRIVACY_POLICY_PATH,
	registryValue,
	SITE_TAGLINE,
	STATUTE_PATH,
	SUPPORT_PATH,
} from "../consts";
import EmailLink from "./EmailLink.astro";

// Ciemna stopka z makiety: logotyp, dane rejestrowe, dokumenty, kontakt.
// Adresu siedziby tu nie ma: art. 5 ustawy o świadczeniu usług drogą
// elektroniczną każe podać go „bezpośrednio dostępnie”, nie na każdej
// stronie – wystarcza link do danych rejestrowych na /fundacja, gdzie adres
// stoi w całości.
const registry = [
	{ label: "KRS", value: registryValue(FOUNDATION.krs) },
	{ label: "NIP", value: registryValue(FOUNDATION.nip) },
	{ label: "REGON", value: registryValue(FOUNDATION.regon) },
];
const link = "transition-colors hover:text-white";
const heading = "font-semibold text-white";
// Pasek w kolorach akcentów – proporcje z makiety.
const stripe = [
	["bg-orange", 3],
	["bg-sun", 1],
	["bg-pink", 2],
	["bg-blue", 4],
	["bg-lime", 1],
] as const;
---

<footer class="bg-ink text-[15px] text-fog">
  <div class="wrap flex flex-col gap-12 pt-16 pb-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-3">
        <span class="font-serif text-4xl leading-none text-white">{LOGOTYPE}</span>
        <span>Fundacja – {SITE_TAGLINE.toLowerCase()}.</span>
      </div>
      <div class="flex flex-col gap-2">
        <h2 class={heading}>Dane fundacji</h2>
        <dl class="flex flex-col gap-2">
          {
            registry.map((item) => (
              <div class="flex gap-1.5">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
        <a href={`${FOUNDATION_PATH}#dane`} class={`${link} underline underline-offset-4`}>Dane rejestrowe</a>
      </div>
      <div class="flex flex-col items-start gap-2">
        <h2 class={heading}>Dokumenty</h2>
        <a href={STATUTE_PATH} class={link}>Statut</a>
        <a href={PRIVACY_POLICY_PATH} class={link}>Prywatność</a>
        <!-- Panel otwiera delegowany listener w ConsentManager.astro – dzięki temu
             przycisk działa też po podmianie DOM przez ClientRouter. -->
        <button type="button" data-cc-preferences class={`${link} cursor-pointer text-left`}>Cookies</button>
        <a href={ACCESSIBILITY_PATH} class={link}>Deklaracja dostępności</a>
      </div>
      <div class="flex flex-col gap-2">
        <h2 class={heading}>Kontakt</h2>
        <EmailLink class={`${link} break-all`} />
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class={link}>
          Instagram<span class="sr-only"> (otwiera się w nowej karcie)</span>
        </a>
        <a href={SUPPORT_PATH} class={link}>Wesprzyj fundację</a>
      </div>
    </div>
    <div class="flex h-3.5 gap-1.5" aria-hidden="true">
      {stripe.map(([color, grow]) => <span class={`${color} rounded-full`} style={`flex: ${grow}`} />)}
    </div>
    <p>© {new Date().getFullYear()} {FOUNDATION.name}</p>
  </div>
</footer>
