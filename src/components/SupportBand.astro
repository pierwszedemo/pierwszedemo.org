---
import { SUPPORT_PATH } from "../consts";

/**
 * Pasmo „Wesprzyj” – zamiennik czwartej pozycji w nawigacji. Siedzi nad
 * stopką na stronach, które mają sens jako wejście dla darczyńcy; strona
 * cyklu koncertów i polityka prywatności go nie pokazują.
 */
---

<aside
  class="grid border-t border-ink md:grid-cols-[5fr_3fr_3fr_5fr]"
  aria-label="Wsparcie fundacji"
>
  <p class="px-5 py-6 text-row font-semibold tracking-[-0.02em] text-balance md:col-span-3 md:px-8">
    Pierwsze demo to dopiero początek. Pomóż młodym twórcom dojść do sceny.
  </p>
  <a
    href={SUPPORT_PATH}
    class="label flex items-center justify-between gap-4 border-t border-hairline px-5 py-6 transition-colors hover:bg-ink hover:text-white md:border-t-0 md:border-l md:px-8"
  >
    Wesprzyj fundację <span aria-hidden="true">→</span>
  </a>
</aside>
