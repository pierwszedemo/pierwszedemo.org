---
import { SUPPORT_PATH } from "../consts";

/**
 * Pasmo „Wesprzyj” – zamiennik pozycji w nawigacji. Siedzi nad stopką na
 * stronach, które mają sens jako wejście dla darczyńcy; strona cyklu koncertów
 * i polityka prywatności go nie pokazują. Strona główna też nie: tam to samo
 * mówi karta „dla partnerów i darczyńców” w sekcji „Dołącz”.
 */
---

<aside class="wrap pt-16 pb-20 md:pt-20 md:pb-28" aria-label="Wsparcie fundacji">
  <div
    class="flex flex-wrap items-end justify-between gap-8 rounded-[28px] bg-orange p-8 md:p-12"
  >
    <p class="max-w-[22ch] font-serif text-[clamp(2rem,3.4vw,3rem)] leading-none tracking-[-0.01em] text-balance">
      Pierwsze demo to dopiero <em>początek.</em> Pomagamy młodym twórcom dojść do sceny.
    </p>
    <a href={SUPPORT_PATH} class="btn btn-ink text-lg">Wesprzyj fundację</a>
  </div>
</aside>
