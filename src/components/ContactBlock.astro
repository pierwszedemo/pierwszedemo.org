---
import { fixHanging } from "../typography";
import Accent from "./Accent.astro";
import EmailLink from "./EmailLink.astro";

/**
 * Sekcja „Kontakt” podstron – ten sam układ co na stronie głównej: nagłówek
 * po lewej, adres dosłownie po prawej. Adres stoi na stronie w całości, a nie
 * jako „Napisz do nas”: nawigacja nie ma pozycji Kontakt, więc to tutaj ktoś
 * szuka adresu.
 */
interface Props {
	heading: string;
	text: string;
}
const { heading, text } = Astro.props;
---

<section class="wrap py-16 md:py-24" aria-labelledby="kontakt-naglowek">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] items-end gap-10">
    <h2
      id="kontakt-naglowek"
      class="font-serif text-[clamp(2.75rem,5.5vw,5rem)] leading-[0.95] tracking-[-0.02em] text-balance"
    >
      <Accent text={heading} />
    </h2>
    <div class="flex flex-col gap-4">
      <EmailLink
        class="font-serif text-[clamp(1.875rem,3vw,2.75rem)] break-words text-blue underline decoration-1 underline-offset-8 hover:text-blue-deep"
      />
      <p class="text-body">{fixHanging(text)}</p>
    </div>
  </div>
</section>
