---
import { fixHanging } from "../typography";

/**
 * Wiersz listy wpisów – wspólny dla bazy wiedzy i aktualności. Ten sam
 * język co „Co robimy” na stronie głównej: data w mono, tytuł serifem,
 * etykieta w pigułce, a na hover kursywa tytułu zamiast odwróconego tła.
 * Tory dopasowane do treści: data, etykieta i strzałka mają stałą długość,
 * reszta należy do tytułu – to po niego się tu przychodzi.
 */
interface Props {
	href: string;
	title: string;
	/** Lewa komórka – data (ISO) albo inny krótki tekst mono. */
	left: string;
	leftDatetime?: string;
	/** Etykieta w pigułce – kategoria albo rodzaj wpisu. */
	label: string;
	/** Drobna linia pod etykietą: `notatka · 2 min`. */
	sub?: string;
}
const { href, title, left, leftDatetime, label, sub } = Astro.props;
---

<li class="border-b border-hairline">
  <a
    href={href}
    class="group grid grid-cols-1 items-center gap-y-3 py-7 md:grid-cols-[8.5rem_minmax(0,1fr)_13rem_2rem] md:gap-x-8 md:py-8"
  >
    <span class="order-2 font-mono text-sm text-muted md:order-none">
      {leftDatetime ? <time datetime={leftDatetime}>{left}</time> : left}
    </span>
    <span
      class="order-1 font-serif text-row leading-[1.05] text-balance group-hover:italic md:order-none"
    >
      {fixHanging(title)}
    </span>
    <span class="order-3 flex flex-wrap items-center gap-x-3 gap-y-1 md:order-none md:flex-col md:items-start">
      <span class="rounded-full border border-hairline bg-white px-3 py-1 text-sm font-semibold">{label}</span>
      {/* Notatka i przewodnik różnią się długością trzy-, czterokrotnie,
          a tytuł tego nie zdradza – stąd rodzaj i czas czytania. */}
      {sub && <span class="font-mono text-xs text-muted">{sub}</span>}
    </span>
    <span
      aria-hidden="true"
      class="hidden text-2xl transition-transform group-hover:translate-x-1 md:block md:text-right"
    >
      →
    </span>
  </a>
</li>
