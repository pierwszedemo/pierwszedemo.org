---
import { fixHanging } from "../typography";

/**
 * Wiersz listy wpisów – wspólny dla bazy wiedzy i aktualności. Świadomy
 * wyjątek od siatki 16 modułów: wiersz to lista, nie pasmo z kolumną boczną.
 * Na torach 5/7/3/1 data dostawała 400 px pustki, a tytuł – to, po co się tu
 * przychodzi – tracił trzecią część szerokości. Tory z makiety są dopasowane
 * do treści: data, etykieta i strzałka mają stałą długość.
 */
interface Props {
	href: string;
	title: string;
	/** Lewa komórka – data (ISO) albo inny krótki tekst mono. */
	left: string;
	leftDatetime?: string;
	/** Prawa etykieta – kategoria albo rodzaj wpisu. */
	label: string;
	/** Drobna linia pod etykietą: `notatka · 2 min`. */
	sub?: string;
	first?: boolean;
	last?: boolean;
}
const { href, title, left, leftDatetime, label, sub, first, last } = Astro.props;
---

<li>
  <a
    href={href}
    class:list={[
      "group grid grid-cols-1 items-center gap-y-2 px-5 py-6 transition-colors md:grid-cols-[150px_1fr_190px_70px] md:gap-0 md:px-0 md:py-0",
      // Wiersz przy focusie robi się czarny, więc domyślny czarny kontur
      // znika – na inwersji musi być biały, do środka.
      "hover:bg-ink hover:text-white focus-visible:bg-ink focus-visible:text-white focus-visible:outline-white focus-visible:outline-offset-[-4px]",
      first ? "border-t border-ink" : "border-t border-hairline",
      last && "border-b border-hairline",
    ]}
  >
    <span
      class="order-2 font-mono text-[13px] text-muted group-hover:text-white/70 group-focus-visible:text-white/70 md:order-none md:px-8 md:py-7"
    >
      {leftDatetime ? <time datetime={leftDatetime}>{left}</time> : left}
      <span class="md:hidden">
        {" "}– {label}{sub && ` · ${sub}`}
      </span>
    </span>
    <span class="order-1 font-serif text-row text-balance md:order-none md:py-7">
      {fixHanging(title)}
    </span>
    <span
      class="order-3 hidden text-[13px] tracking-[0.14em] text-muted uppercase group-hover:text-white/70 group-focus-visible:text-white/70 md:order-none md:block md:py-7"
    >
      {label}
      {/* Notatka i przewodnik różnią się długością trzy-, czterokrotnie,
          a tytuł tego nie zdradza. Etykieta siedzi tu, a nie pod datą:
          kolumna daty ma po paddingu 86 px i „przewodnik · 12 min”
          łamało się na dwie linie. Tu jest 190 px bez paddingu. */}
      {
        sub && (
          <span class="mt-1.5 block font-mono text-[11px] tracking-[0.1em] whitespace-nowrap">
            {sub}
          </span>
        )
      }
    </span>
    <span
      aria-hidden="true"
      class="hidden text-[22px] md:block md:px-8 md:py-7 md:text-right"
    >
      →
    </span>
  </a>
</li>
