---
import { HOME_CITY, SITE_NAME, SITE_TAGLINE } from "../../consts";
import type { HomepageDoc } from "../../strony";
import { fixHanging } from "../../typography";
import Accent from "../Accent.astro";
import { field } from "./field";

interface Props {
	home: HomepageDoc;
}
const { home } = Astro.props;
---

{
  /* Nagłówkiem strony jest pigułka nad sloganem, nie slogan: „Fundacja
     Pierwsze Demo · wsparcie młodych twórców muzycznych · Gdańsk” niesie
     frazy, pod które ta strona ma się wyświetlać, a slogan nie niesie
     żadnej. Wizualnie h1 zostaje małą etykietą, a slogan – największym
     tekstem na stronie. */
}
<h1
  class="flex items-center gap-2.5 self-start rounded-3xl border border-hairline bg-white py-2 pr-4 pl-2.5 text-[15px] leading-snug font-semibold"
>
  <span class="size-3 shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
  <span>{SITE_NAME} · {SITE_TAGLINE.toLowerCase()} · {HOME_CITY}</span>
</h1>
<p
  class="font-serif text-hero leading-[0.9] tracking-[-0.02em] text-balance text-body"
  data-tina-field={field(home, "slogan")}
>
  <Accent text={home.slogan} class="text-blue not-italic" />
</p>
<p class="max-w-[32.5rem] text-xl text-body" data-tina-field={field(home, "intro")}>
  {fixHanging(home.intro)}
</p>
<div class="flex flex-wrap gap-3">
  <a href="#co-robimy" class="btn btn-lg btn-ink">Zobacz, co robimy</a>
  <a href="#dolacz" class="btn btn-lg btn-ghost">Dołącz do nas</a>
</div>
