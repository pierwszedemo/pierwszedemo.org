---
import { HOME_CITY, SITE_NAME } from "../../consts";
import type { FoundationPageDoc } from "../../strony";
import { fixHanging } from "../../typography";
import { field } from "./field";

interface Props {
	page: FoundationPageDoc;
}
const { page } = Astro.props;
---

<div class="px-5 pt-10 pb-9 md:px-8 md:pt-13 lg:border-r lg:border-hairline">
  <p class="label text-muted">({SITE_NAME} – {HOME_CITY})</p>
  <h1
    class="mt-5 font-serif text-page leading-[0.95] tracking-[-0.02em] text-balance"
    data-tina-field={field(page, "heading")}
  >
    {fixHanging(page.heading)}
  </h1>
</div>
<p
  class="flex items-end bg-ink px-5 py-7 font-serif text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.05] text-white text-balance md:px-8 lg:bg-transparent lg:text-ink"
  data-tina-field={field(page, "tagline")}
>
  {fixHanging(page.tagline)}
</p>
