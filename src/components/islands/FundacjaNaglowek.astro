---
import { PAGE_HEADERS } from "../../consts";
import type { FoundationPageDoc } from "../../strony";
import PageHeader from "../PageHeader.astro";
import { field } from "./field";

interface Props {
	page: FoundationPageDoc;
}
const { page } = Astro.props;
---

<PageHeader
  eyebrow={PAGE_HEADERS.fundacja.eyebrow}
  title={page.heading}
  intro={page.tagline}
  titleField={field(page, "heading")}
  introField={field(page, "tagline")}
/>
