---
import { HOME_CITY, SITE_NAME } from "../../consts";
import type { FoundationPageDoc } from "../../strony";
import PageHeader from "../PageHeader.astro";
import { field } from "./field";

interface Props {
	page: FoundationPageDoc;
}
const { page } = Astro.props;
---

<PageHeader
  eyebrow={`${SITE_NAME} · ${HOME_CITY}`}
  title={page.heading}
  intro={page.tagline}
  dot="bg-lime"
  titleField={field(page, "heading")}
  introField={field(page, "tagline")}
/>
