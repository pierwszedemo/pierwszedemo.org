---
import { STATUTE_PATH, SUPPORT_PATH } from "../../consts";
import type { HomepageDoc } from "../../strony";
import { fixHanging } from "../../typography";
import Accent from "../Accent.astro";
import EmailLink from "../EmailLink.astro";
import { field } from "./field";

interface Props {
	home: HomepageDoc;
}
const { home } = Astro.props;

// Karty są stałe (obiekt, nie lista w Tinie), bo każda ma inne wyjście:
// darczyńcy idą na /wesprzyj, muzycy i organizatorzy piszą na adres fundacji.
// Darczyńcy stoją pierwsi – od nich zależy, czy fundacja zrobi cokolwiek
// z pozostałych dwóch – ale karty są równe: większa kafelka rozbijała rytm.
const people = [
	{ key: "muzycy", class: "bg-lime" },
	{ key: "organizatorzy", class: "border border-hairline bg-paper" },
] as const;
const donors = home.joinCards.darczyncy;
const card = "flex min-h-95 flex-col justify-between gap-10 rounded-[28px] p-8";
const kicker = "font-serif text-[28px] leading-tight italic";
const title = "font-serif text-[40px] leading-none text-balance";
---

{/* Nowy wiersz w nagłówku (Enter w Tinie) łamie linię od md; na telefonie
    to zwykła spacja – krótki ekran i tak zawija tekst po swojemu. */}
<h2
  id="dolacz-naglowek"
  class="max-w-[47.5rem] font-serif text-page leading-[0.95] tracking-[-0.02em] text-balance"
  data-tina-field={field(home, "join")}
>
  {
    home.join.split("\n").map((line, index) => (
      <>
        {index > 0 && (
          <>
            <br class="max-md:hidden" />{" "}
          </>
        )}
        <Accent text={line} />
      </>
    ))
  }
</h2>
<ul class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] gap-5">
  <li class={`${card} bg-orange`} data-tina-field={field(donors)}>
    <span class={kicker}>{fixHanging(donors.audience)}</span>
    <div class="flex flex-col gap-4">
      <h3 class={title}>{fixHanging(donors.title)}</h3>
      <p>{fixHanging(donors.text)}</p>
      <p class="text-[15px]">
        Darowiznę odliczysz od podatku: do 6% dochodu, firmy do 10%.{" "}
        <a href={`${SUPPORT_PATH}#podatek`} class="underline underline-offset-4 hover:no-underline">Jak to działa</a>
      </p>
      <div class="flex flex-wrap items-center gap-5">
        <a href={SUPPORT_PATH} class="btn btn-ink">{donors.cta}</a>
        <a href={STATUTE_PATH} class="hit font-semibold underline underline-offset-4 hover:no-underline">Statut</a>
      </div>
    </div>
  </li>
  {
    people.map(({ key, class: background }) => {
      const data = home.joinCards[key];
      return (
        <li class={`${card} ${background}`} data-tina-field={field(data)}>
          <span class={kicker}>{fixHanging(data.audience)}</span>
          <div class="flex flex-col gap-4">
            <h3 class={title}>{fixHanging(data.title)}</h3>
            <p class:list={[key === "organizatorzy" && "text-body"]}>{fixHanging(data.text)}</p>
            <EmailLink class="btn btn-ink self-start">{data.cta}</EmailLink>
          </div>
        </li>
      );
    })
  }
</ul>
