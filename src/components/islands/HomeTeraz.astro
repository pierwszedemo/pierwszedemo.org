---
import { withUtm } from "../../consts";
import type { HomepageDoc } from "../../strony";
import { fixHanging } from "../../typography";
import { field } from "./field";

interface Props {
  home: HomepageDoc;
}
const { home } = Astro.props;
---

{
  home.teraz.map((project) => {
    const external = project.href.startsWith("http");
    return (
      <li data-tina-field={field(project)}>
        <a
          href={external ? withUtm(project.href, "teraz") : project.href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener" : undefined}
          class="group flex flex-col gap-1.5"
        >
          <span class="text-roster font-semibold tracking-[-0.02em] underline decoration-1 underline-offset-[6px] group-hover:decoration-2">
            {fixHanging(project.name)}
          </span>
          <span class="label text-white/60">
            {fixHanging(project.meta)}
            {external && <span class="sr-only"> (otwiera się w nowej karcie)</span>}
          </span>
        </a>
      </li>
    );
  })
}
