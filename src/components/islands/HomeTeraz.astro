---
import { withUtm } from "../../consts";
import type { HomepageDoc } from "../../strony";
import { fixHanging } from "../../typography";
import Accent from "../Accent.astro";
import { field } from "./field";

interface Props {
	home: HomepageDoc;
}
const { home } = Astro.props;

// Limonkowe koło na telefonie siedzi małe w prawym dolnym rogu, nie w górnym:
// biały nagłówek na limonce ma kontrast 1,2:1, a na wąskim ekranie nagłówek
// sięga prawej krawędzi. Na dole dotyka go tylko biały przycisk.
---

{
  home.teraz.map((project) => {
    const external = project.href.startsWith("http");
    return (
      <article
        class="relative flex flex-wrap items-end justify-between gap-10 overflow-hidden rounded-[32px] bg-blue p-[clamp(2rem,5vw,4.5rem)] text-white"
        data-tina-field={field(project)}
      >
        <span
          class="absolute -right-16 -bottom-16 size-36 rounded-full bg-lime md:-top-35 md:-right-15 md:bottom-auto md:size-95"
          aria-hidden="true"
        />
        <div class="relative flex min-w-0 flex-[999_1_30rem] flex-col gap-5">
          <h2 class="font-serif text-band leading-[0.9] tracking-[-0.02em] text-balance">
            <Accent text={project.name} />
          </h2>
          <p class="max-w-[32.5rem] text-[21px] text-[#f2f4ff]">{fixHanging(project.meta)}</p>
        </div>
        <a
          href={external ? withUtm(project.href, "teraz") : project.href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener" : undefined}
          class="btn btn-lg btn-light relative"
        >
          {project.cta}
          {external && <span class="sr-only"> (otwiera się w nowej karcie)</span>}
        </a>
      </article>
    );
  })
}
