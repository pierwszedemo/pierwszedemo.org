---
import { withUtm } from "../../consts";
import type { FoundersDoc } from "../../strony";
import { fixHanging } from "../../typography";
import EmailLink from "../EmailLink.astro";
import { field } from "./field";

interface Props {
	person: FoundersDoc[keyof FoundersDoc];
}
const { person } = Astro.props;
---

<h3 class="flex flex-col gap-4">
  <span class="font-serif text-item leading-none" data-tina-field={field(person, "fullName")}>
    {person.fullName}
  </span>
  <span class="flex flex-wrap gap-2 text-sm font-semibold">
    <span class="rounded-full bg-lime px-3 py-1.5">{person.role}</span>
    <span class="rounded-full border border-hairline bg-white px-3 py-1.5">{person.jobTitle}</span>
  </span>
</h3>
<div class="flex max-w-[62ch] flex-col gap-4 text-body">
  {person.bio.map((paragraph, index) => (
    <p data-tina-field={field(person, "bio", index)}>{fixHanging(paragraph)}</p>
  ))}
  {/* gap-y-5: po zawinięciu wiersze stoją 44 px od siebie, więc pola `hit`
      (cel dotyku z WCAG 2.5.5) nie nachodzą na siebie. */}
  <p class="flex flex-wrap gap-x-6 gap-y-5">
    <EmailLink address={person.email} class="text-link hit" />
    <a href={withUtm(person.href, "zespol")} target="_blank" rel="noopener" class="text-link hit">
      {new URL(person.href).host}
      <span class="sr-only"> (otwiera się w nowej karcie)</span>
    </a>
  </p>
</div>
