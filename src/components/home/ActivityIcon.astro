---
/**
 * Pięć ozdobnych znaków z makiety – po jednym na wiersz „Co robimy”, po kolei.
 * Szósty i kolejny program dostaje znaki od początku. Kształty nie znaczą nic
 * konkretnego (słońce nad sceną, płyta, półki, schody, dwa koła), więc
 * przypisanie do numeru, a nie do kotwicy działania, niczego nie psuje.
 */
interface Props {
	index: number;
	class?: string;
}
const { index, class: className } = Astro.props;
const variant = index % 5;
---

<svg viewBox="0 0 56 56" aria-hidden="true" class={className}>
  {
    variant === 0 && (
      <>
        <path d="M4 52 A24 24 0 0 1 52 52 Z" fill="#ff5a1f" />
        <circle cx="28" cy="16" r="8" fill="#ffc93c" />
      </>
    )
  }
  {
    variant === 1 && (
      <>
        <circle cx="28" cy="28" r="26" fill="#2b3bff" />
        <circle cx="28" cy="28" r="10" fill="#d4ff3a" />
        <circle cx="28" cy="28" r="2.5" fill="#15151a" />
      </>
    )
  }
  {
    variant === 2 && (
      <>
        <rect x="6" y="10" width="12" height="44" fill="#15151a" />
        <rect x="22" y="20" width="12" height="34" fill="#3bd68a" />
        <rect x="38" y="4" width="12" height="50" transform="rotate(10 44 54)" fill="#d4ff3a" />
      </>
    )
  }
  {variant === 3 && <path d="M2 54 V42 H16 V30 H30 V18 H44 V6 H54 V54 Z" fill="#ff8ad8" />}
  {
    variant === 4 && (
      <>
        <circle cx="20" cy="28" r="18" fill="#ffc93c" />
        <circle cx="36" cy="28" r="18" fill="#2b3bff" style="mix-blend-mode: multiply" />
      </>
    )
  }
</svg>
