---
import { getCovers, isoDate, plDate } from "../collections";
import { coverArtSvg, coverParams } from "../covers";
import { fixHanging } from "../typography";

/**
 * Karta wpisu: „Co się dzieje” na stronie głównej i trzy najnowsze wpisy na
 * listach. Ilustracja to okładka wpisu (src/covers.ts) bez tytułu – ta sama
 * grafika, co jego obrazek OG, więc wpis wygląda tak samo na stronie i w
 * podglądzie linku. Okładka ma 1200×630 z grafiką po jednej stronie, a karta
 * 4:3, więc SVG jest przycinane od strony kolumny tekstu (`slice` przy prawej
 * krawędzi, przy lustrze – przy lewej) i grafika zostaje cała.
 */
interface Props {
	href: string;
	/** Slug wpisu – klucz w przydziale okładek (`getCovers`). */
	slug: string;
	title: string;
	date: Date;
	label: string;
	/** h3 pod nagłówkiem sekcji (strona główna), h2 wprost pod h1 (listy). */
	heading?: "h2" | "h3";
}
const { href, slug, title, date, label, heading: Heading = "h3" } = Astro.props;
const params = (await getCovers()).get(slug) ?? coverParams(slug);
const art = coverArtSvg(
	params,
	`aria-hidden="true" preserveAspectRatio="${params.mirror ? "xMinYMid" : "xMaxYMid"} slice" class="absolute inset-0 size-full"`,
);
---

<a href={href} class="group flex flex-col gap-5">
  <div class="relative aspect-[4/3] overflow-hidden rounded-[20px]">
    <Fragment set:html={art} />
    <span class="absolute top-4 left-4 rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-ink">{label}</span>
  </div>
  <div>
    <time datetime={isoDate(date)} class="text-[15px] text-muted">{plDate(date)}</time>
    <Heading
      class="mt-1.5 font-serif text-row leading-[1.05] text-balance decoration-1 underline-offset-[5px] group-hover:underline"
    >
      {fixHanging(title)}
    </Heading>
  </div>
</a>
