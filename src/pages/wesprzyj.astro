---
import ContactBlock from "../components/ContactBlock.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import {
	DONATION_TITLE,
	FOUNDATION,
	FOUNDATION_PATH,
	HOME_CITY,
	SITE_NAME,
	SITE_URL,
	SUPPORT_PATH,
} from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbJsonLd } from "../schema";
import { fixHanging } from "../typography";

/*
 * Jedno wejście dla darczyńcy, wolontariusza i partnera. Bez formularzy
 * i bramki płatności: przelew na konto fundacji to nie zbiórka publiczna,
 * nie wymaga zgłoszenia ani regulaminu, a formularz pociągnąłby za sobą
 * klauzulę RODO i nowy wiersz w polityce. Konto zakłada się dopiero po
 * wpisie do KRS – dopóki go nie ma, sekcja mówi to wprost.
 */
const canonical = new URL(SUPPORT_PATH, SITE_URL).href;
const breadcrumb = breadcrumbJsonLd(
	[
		{ name: "Start", path: "/" },
		{ name: "Wesprzyj", path: SUPPORT_PATH },
	],
	canonical,
);

const transfer = [
	{ label: "Odbiorca", value: FOUNDATION.name },
	{
		label: "Adres",
		value: `${FOUNDATION.street}, ${FOUNDATION.postalCode} ${FOUNDATION.city}`,
	},
	{
		label: "Numer konta",
		value: FOUNDATION.iban || "w trakcie zakładania",
	},
	{ label: "Tytuł przelewu", value: DONATION_TITLE },
] as const;

// Trzy karty jak „Dołącz” na stronie głównej. Słowo nad tytułem powtarza
// podtytuł strony: pieniądze, czas albo miejsce.
const WAYS = [
	{
		id: "darowizna",
		kicker: "pieniądze",
		title: "Darowizna",
		text: "Jednorazowa albo stała, dowolnej wysokości. Każda złotówka przeznaczana jest na cele statutowe: koncerty, nagrania, warsztaty i wsparcie konkretnych twórców.",
		color: "bg-orange",
	},
	{
		id: "wolontariat",
		kicker: "czas",
		title: "Wolontariat",
		text: "Przy wydarzeniach potrzebujemy pomocy. Napisz, co Cię interesuje, w czym chcesz nam pomóc i ile masz czasu – odezwiemy się przed najbliższym wydarzeniem.",
		color: "bg-lime",
	},
	{
		id: "partnerstwo",
		kicker: "miejsce",
		title: "Partnerstwo",
		text: "Sala na koncert, studio na sesję, sprzęt, druk, patronat medialny albo wsparcie finansowe konkretnego projektu.",
		color: "border border-hairline bg-white",
	},
] as const;

const columnHeading = "font-serif text-item leading-none";
---

<BaseLayout
  title={`Wesprzyj fundację – darowizna, wolontariat, partnerstwo | ${SITE_NAME}`}
  description={`Jak wesprzeć ${SITE_NAME} z ${HOME_CITY}a: darowizna na cele statutowe z odliczeniem od podatku, wolontariat przy koncertach, partnerstwo firm i instytucji.`}
  canonicalPath={SUPPORT_PATH}
  extraJsonLd={[breadcrumb]}
>
  <Nav />

  <main id="tresc">
    <PageHeader
      eyebrow={`${SITE_NAME} · wsparcie`}
      title="Wesprzyj *fundację.*"
      intro="Pieniądze, czas albo miejsce – każde z tych trzech przybliża kogoś do pierwszego koncertu."
    />

    <Section id="jak" heading="Jak *pomóc*" class="!pt-0">
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] gap-5">
        {
          WAYS.map((way) => (
            <li
              id={way.id}
              class={`flex min-h-80 scroll-mt-6 flex-col justify-between gap-10 rounded-[28px] p-8 ${way.color}`}
            >
              <span class="font-serif text-[28px] leading-tight italic">{way.kicker}</span>
              <div class="flex flex-col gap-4">
                <h3 class="font-serif text-[40px] leading-none">{way.title}</h3>
                <p class:list={[way.id === "partnerstwo" && "text-body"]}>{fixHanging(way.text)}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </Section>

    {/* Dane do przelewu w niebieskiej karcie – to jest cel strony, więc
        stoi tak, jak pasmo „Teraz” na stronie głównej. */}
    <section id="przelew" class="wrap pb-16 md:pb-24" aria-labelledby="przelew-naglowek">
      <div
        class="relative overflow-hidden rounded-[32px] bg-blue p-[clamp(2rem,5vw,4.5rem)] text-white"
      >
        <span
          class="absolute -top-20 -right-20 size-40 rounded-full bg-lime md:-top-35 md:-right-15 md:size-95"
          aria-hidden="true"
        ></span>
        <h2
          id="przelew-naglowek"
          class="relative max-w-[12ch] font-serif text-band leading-[0.9] tracking-[-0.02em] text-balance"
        >
          Dane do <em>przelewu</em>
        </h2>
        <dl class="relative mt-10 max-w-[48rem] border-t border-white/40">
          {
            transfer.map((entry) => (
              <div class="grid gap-1 border-b border-white/25 py-4 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8">
                <dt class="label pt-1 text-[#f2f4ff]">{entry.label}</dt>
                <dd
                  class:list={[
                    "text-xl",
                    entry.label === "Numer konta" && FOUNDATION.iban && "font-mono tracking-wide",
                  ]}
                >
                  {entry.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="border-y border-hairline bg-white">
      <div class="wrap grid gap-x-16 gap-y-14 py-16 md:grid-cols-2 md:py-24">
        <div id="podatek" class="flex scroll-mt-6 flex-col gap-6">
          <h2 class={columnHeading}>Odliczenie od <em>podatku</em></h2>
          <p class="text-lg leading-[1.6] text-body">
            Darowiznę na cele statutowe fundacji odliczysz od dochodu w rocznym zeznaniu: osoby
            fizyczne do 6% dochodu (art. 26 ust. 1 pkt 9 ustawy o PIT), firmy do 10% (art. 18 ust. 1
            pkt 1 ustawy o CIT). Dowodem jest potwierdzenie przelewu z tytułem „{DONATION_TITLE}” – nie
            potrzebujesz od nas żadnego dodatkowego dokumentu.
          </p>
        </div>
        <div id="na-co" class="flex scroll-mt-6 flex-col gap-6">
          <h2 class={columnHeading}>Na co idą <em>pieniądze</em></h2>
          <div class="flex flex-col gap-5 text-lg leading-[1.6] text-body">
            <p>
              Na realizację celów statutowych: honoraria dla artystów i techniki na koncertach,
              wynajem sal i sprzętu, nagrania, dystrybucję i materiały prasowe debiutantów, warsztaty
              i konsultacje. Członkowie Zarządu nie pobierają wynagrodzenia za pełnienie funkcji,
              a fundacja nie prowadzi działalności gospodarczej.
            </p>
            <p>
              Co roku publikujemy{" "}
              <a href={`${FOUNDATION_PATH}#sprawozdania`} class="text-link">
                sprawozdanie z działalności
              </a>{" "}
              – z niego dowiesz się, co udało nam się zrealizować.
            </p>
          </div>
        </div>
      </div>
    </section>

    <ContactBlock heading="Po prostu *napisz.*" text="Wolontariat, partnerstwo, darowizna rzeczowa?" />
  </main>

  <Footer />
</BaseLayout>
