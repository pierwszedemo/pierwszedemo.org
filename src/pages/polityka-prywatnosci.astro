---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import {
  PRIVACY_POLICY_PATH,
  PRIVACY_POLICY_UPDATED,
  PRIVACY_SECTIONS,
  PRIVACY_TOOLS,
  SITE_HOST,
  SITE_NAME,
} from "../consts";

const headers = [
  "Narzędzie",
  "Dostawca",
  "Po co",
  "Zapis na urządzeniu",
  "Podstawa prawna",
];
---

<BaseLayout
  title={`Polityka prywatności – ${SITE_NAME}`}
  description={`Jakie dane zbiera strona ${SITE_HOST}, jakie cookies są używane, komu są przekazywane i jak wycofać zgodę.`}
  canonicalPath={PRIVACY_POLICY_PATH}
  dateModified={PRIVACY_POLICY_UPDATED}
>
  <div class="flex min-h-dvh flex-col">
    <Nav />

    <main class="flex-1">
      <header
        class="flex flex-col gap-6 border-b border-ink px-5 pt-10 pb-9 md:flex-row md:items-end md:justify-between md:px-8 md:pt-13"
      >
        <h1 class="text-page leading-[0.95] font-semibold tracking-[-0.03em]">
          Polityka<br />prywatności
        </h1>
        <p class="label text-muted md:text-right">
          Aktualizacja: {PRIVACY_POLICY_UPDATED}
        </p>
      </header>

      {
        PRIVACY_SECTIONS.map((section) => (
          <section class="grid border-b border-hairline md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:grid-aside-left">
            <h2 class="label px-5 pt-6 text-muted md:border-r md:border-hairline md:px-8 md:py-9">
              {section.title}
            </h2>
            <div class="flex max-w-[68ch] flex-col gap-4 px-5 py-6 md:px-10 md:py-9">
              {section.paragraphs.map((paragraph) => (
                <p class="text-[15.5px] leading-[1.7] text-body">{paragraph}</p>
              ))}
            </div>
          </section>
        ))
      }

      <!-- Tabela narzędzi – te same wpisy, które opisuje panel ustawień
           cookies (src/scripts/consent.ts). -->
      <section
        class="grid border-b border-hairline md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:grid-aside-left"
      >
        <h2 class="label px-5 pt-6 text-muted md:border-r md:border-hairline md:px-8 md:py-9">
          Narzędzia zewnętrzne
        </h2>
        <div class="flex flex-col gap-6 px-5 py-6 md:px-10 md:py-9">
          <div class="-mx-5 overflow-x-auto px-5 md:mx-0 md:px-0">
            <table class="w-full min-w-[46rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-ink">
                  {
                    headers.map((header) => (
                      <th class="label py-3 pr-6 font-medium text-muted">
                        {header}
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  PRIVACY_TOOLS.map((tool) => (
                    <tr class="border-b border-hairline align-top">
                      <td class="py-4 pr-6 text-sm font-semibold">
                        {tool.name}
                      </td>
                      <td class="py-4 pr-6 text-sm text-muted">
                        {tool.provider}
                      </td>
                      <td class="max-w-[28ch] py-4 pr-6 text-sm leading-relaxed text-body">
                        {tool.purpose}
                      </td>
                      <td class="py-4 pr-6 text-sm text-body">{tool.storage}</td>
                      <td class="py-4 text-sm text-muted">{tool.basis}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <button
            type="button"
            data-cc-preferences
            class="label cursor-pointer self-start border border-ink px-5 py-3 transition-colors hover:bg-ink hover:text-white"
          >
            Zmień ustawienia cookies
          </button>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
