---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import {
	PRIVACY_POLICY_PATH,
	PRIVACY_POLICY_UPDATED,
	PRIVACY_SECTIONS,
	PRIVACY_TOOLS,
	SITE_HOST,
	SITE_NAME,
} from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const headers = ["Narzędzie", "Dostawca", "Po co", "Zapis na urządzeniu", "Podstawa prawna"];

// Sekcja dokumentu: tytuł serifem z lewej, tekst z prawej, cienka linia nad
// każdą – ten sam układ w polityce i w deklaracji dostępności.
const sectionClass =
	"grid gap-x-16 gap-y-4 border-b border-hairline py-10 md:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] md:py-12";
const headingClass = "font-serif text-[2rem] leading-[1.05] text-balance";
---

<BaseLayout
  title={`Polityka prywatności – ${SITE_NAME}`}
  description={`Jakie dane zbiera strona ${SITE_HOST}, jakie cookies są używane, komu są przekazywane i jak wycofać zgodę.`}
  canonicalPath={PRIVACY_POLICY_PATH}
  dateModified={PRIVACY_POLICY_UPDATED}
>
  <Nav />

  <main id="tresc">
    <PageHeader eyebrow={SITE_NAME} title="Polityka prywatności">
      <p slot="aside" class="label text-muted md:text-right">Aktualizacja: {PRIVACY_POLICY_UPDATED}</p>
    </PageHeader>

    <div class="wrap pb-16 md:pb-24">
      <div class="border-t-[1.5px] border-ink">
        {
          PRIVACY_SECTIONS.map((section) => (
            <section class={sectionClass}>
              <h2 class={headingClass}>{section.title}</h2>
              <div class="flex max-w-[68ch] flex-col gap-4">
                {section.paragraphs.map((paragraph) => (
                  <p class="text-[17px] leading-[1.65] text-body">{paragraph}</p>
                ))}
              </div>
            </section>
          ))
        }

        <!-- Tabela narzędzi – te same wpisy, które opisuje panel ustawień
             cookies (src/scripts/consent.ts). -->
        <section class={sectionClass}>
          <h2 class={headingClass}>Narzędzia zewnętrzne</h2>
          <div class="flex min-w-0 flex-col gap-6">
            <!-- Pięć kolumn mieści się dopiero od xl. Węższa kolumna to karty,
                 nie przewijana tabela: przewijany kontener musi przyjmować fokus
                 (WCAG 2.1.1), a mając ~900 px wysokości, nie mieścił się na
                 żadnym ekranie, więc górę jego obrysu zawsze przykrywała
                 nawigacja (2.4.12). Wersja ukryta przez `hidden` znika też
                 z drzewa dostępności, więc czytnik nie słyszy treści dwa razy. -->
            <ul class="flex flex-col gap-4 xl:hidden">
              {
                PRIVACY_TOOLS.map((tool) => (
                  <li class="rounded-[20px] border border-hairline bg-white p-5">
                    <h3 class="font-semibold">{tool.name}</h3>
                    <dl class="mt-3 grid gap-x-4 gap-y-3 text-sm sm:grid-cols-[10rem_minmax(0,1fr)]">
                      {[
                        [headers[1], tool.provider],
                        [headers[2], tool.purpose],
                        [headers[3], tool.storage],
                        [headers[4], tool.basis],
                      ].map(([label, value]) => (
                        <div class="contents">
                          <dt class="label text-muted">{label}</dt>
                          <dd class="-mt-2 leading-relaxed text-body sm:mt-0">{value}</dd>
                        </div>
                      ))}
                    </dl>
                  </li>
                ))
              }
            </ul>
            <div class="hidden overflow-hidden rounded-[20px] border border-hairline bg-white xl:block">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr class="border-b border-hairline">
                    {
                      headers.map((header) => (
                        <th class="label px-5 py-4 text-muted">{header}</th>
                      ))
                    }
                  </tr>
                </thead>
                <tbody>
                  {
                    PRIVACY_TOOLS.map((tool) => (
                      <tr class="border-b border-hairline align-top last:border-b-0">
                        <td class="px-5 py-4 text-sm font-semibold">{tool.name}</td>
                        <td class="px-5 py-4 text-sm text-muted">{tool.provider}</td>
                        <td class="max-w-[28ch] px-5 py-4 text-sm leading-relaxed text-body">{tool.purpose}</td>
                        <td class="px-5 py-4 text-sm text-body">{tool.storage}</td>
                        <td class="px-5 py-4 text-sm text-muted">{tool.basis}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <button type="button" data-cc-preferences class="btn btn-ghost cursor-pointer self-start">
              Zmień ustawienia cookies
            </button>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
