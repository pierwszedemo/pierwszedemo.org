---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import EmailLink from "../components/EmailLink.astro";
import {
  HOME_CITY,
  OFFER_CATALOG_ID,
  PERSON_ID,
  PERSON_NAME,
  ROSTER,
  SERVICES,
  SERVICE_PATH,
  SITE_NAME,
  SITE_TAGLINE,
  SITE_URL,
  withUtm,
} from "../consts";
import { breadcrumbJsonLd } from "../schema";

/*
 * Strona usługowa. Strona główna jest profilem osoby i rankuje na nazwisko
 * oraz „manager muzyczny"; ta jest o samej współpracy – dla kogo, co obejmuje,
 * jak się zaczyna, ile kosztuje – i celuje w zapytania z intencją szukania
 * managera („współpraca z managerem", „menedżer artysty", „ile kosztuje
 * manager muzyczny"). Dlatego h1 i tytuł nie powtarzają tytułu strony głównej.
 */

const canonical = new URL(SERVICE_PATH, SITE_URL).href;
const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Start", path: "/" },
    { name: "Współpraca", path: SERVICE_PATH },
  ],
  canonical,
);
const serviceJsonLd = {
  "@type": "Service",
  "@id": `${canonical}#usluga`,
  name: "Management muzyczny",
  serviceType: "Management artystów",
  description:
    "Prowadzenie kariery muzyków i zespołów alternatywnych: strategia, wydawnictwa, booking koncertowy i pieniądze.",
  url: canonical,
  provider: { "@id": PERSON_ID },
  areaServed: { "@type": "Country", name: "Polska" },
  audience: {
    "@type": "Audience",
    audienceType: "muzycy i zespoły alternatywne",
  },
  hasOfferCatalog: { "@id": OFFER_CATALOG_ID },
};

const STEPS = [
  {
    no: "01",
    title: "Mail",
    text: "Wyślij, co masz: linki do muzyki i socialów, a jeśli jest to również EPK. Nie potrzebuję prezentacji, potrzebuję usłyszeć materiał i zobaczyć, gdzie jesteś.",
  },
  {
    no: "02",
    title: "Rozmowa",
    text: `Godzina online albo w ${HOME_CITY}u. Ty mówisz, dokąd chcesz dojść, ja mówię, co widzę i czy jestem w stanie w tym pomóc. Jeśli nie – powiem wprost.`,
  },
  {
    no: "03",
    title: "Plan i zasady",
    text: "Jeśli obie strony chcą, spisujemy plan na najbliższe miesiące i zasady współpracy: zakres, prowizję, czas trwania, warunki rozstania. Potem zaczynamy.",
  },
] as const;

/*
 * FAQ jest treścią widoczną, nie znacznikiem FAQPage – Google od 2023 pokazuje
 * ten rich result tylko serwisom rządowym i medycznym, a same pytania niosą
 * warianty frazy (menedżer, menadżer, ile kosztuje), których reszta strony
 * celowo nie powtarza.
 */
const FAQ = [
  {
    q: "Czym zajmuje się manager muzyczny?",
    a: "Prowadzi karierę artysty od strony strategii i organizacji: planuje premiery i koncerty, rozmawia z wytwórniami, agencjami i mediami, pilnuje terminów, umów i pieniędzy. Artysta ma robić muzykę; manager ma zadbać, żeby ta muzyka miała gdzie i do kogo dotrzeć.",
  },
  {
    q: "Kiedy artysta potrzebuje managera?",
    a: "Wtedy, gdy organizacja zaczyna zabierać czas, który powinien iść na muzykę. Kiedy masz gotowy materiał, regularne koncerty albo pierwszych słuchaczy i nie nadążasz z resztą. Wcześniej wystarczy dobry plan; o tym jest większość wpisów na blogu.",
  },
  {
    q: "Ile kosztuje manager muzyczny?",
    a: "W branży standardem jest prowizja procentowa od przychodów artysty, nie stała opłata – manager zarabia wtedy, kiedy zarabia artysta. Konkretne warunki zależą od zakresu pracy i etapu kariery; to temat pierwszej rozmowy, nie cennika.",
  },
  {
    q: "Manager, menedżer czy menadżer – jak to pisać?",
    a: "Słownik dopuszcza „menedżer” i „menadżer”; branża muzyczna pisze najczęściej z angielska „manager”. To ta sama rola – na tej stronie używam wersji angielskiej, bo tak mówi się w rozmowach z wytwórniami i festiwalami.",
  },
  {
    q: `Czy pracujesz tylko z artystami z Trójmiasta?`,
    a: `Nie. Baza jest w ${HOME_CITY}u, ale większość pracy managera to maile, telefony i wyjazdy – na koncerty, festiwale i showcase’y w całej Polsce. Lokalizacja artysty nie ma znaczenia; regularny kontakt ma.`,
  },
  {
    q: "Czym różni się manager od bookera i wydawcy?",
    a: "Booker sprzedaje koncerty, wydawca inwestuje w nagrania i ich promocję. Manager stoi po stronie artysty i koordynuje jedno i drugie – a przy mniejszych projektach często sam robi booking i prowadzi wydawnictwa, dopóki nie ma sensu oddać ich dalej.",
  },
] as const;

// Lewa kolumna etykiet ma szerokość kolumny zdjęcia z hero – ta sama siatka
// co na stronie głównej i /o-mnie, żeby strona nie wyglądała jak inny serwis.
const row =
  "grid border-b border-hairline md:grid-cols-[clamp(15rem,31.25%,25rem)_minmax(0,1fr)]";
const rowLabel =
  "label px-5 pt-7 text-muted md:border-r md:border-hairline md:px-8 md:py-10";
const rowBody = "px-5 py-7 md:px-8 md:py-10 lg:px-10";
const prose =
  "flex max-w-[62ch] flex-col gap-5 text-[clamp(1.05rem,1.6vw,1.25rem)] leading-[1.6] text-body";
const link = "underline decoration-1 underline-offset-4";
---

<BaseLayout
  title={`Współpraca z managerem muzycznym – zakres i zasady | ${SITE_NAME}`}
  description={`Management muzyczny dla artystów alternatywnych: strategia kariery, wydawnictwa, booking i pieniądze. ${PERSON_NAME}, manager artystów z ${HOME_CITY}a – dla kogo, co obejmuje i jak zaczynamy.`}
  canonicalPath={SERVICE_PATH}
  extraJsonLd={[serviceJsonLd, breadcrumb]}
>
  <div class="flex min-h-dvh flex-col">
    <Nav active="Współpraca" />

    <main class="flex-1">
      <header
        class="grid border-b border-ink lg:grid-cols-[minmax(0,1fr)_clamp(15rem,31.25%,25rem)]"
      >
        <div
          class="px-5 pt-10 pb-9 md:px-8 md:pt-13 lg:border-r lg:border-hairline"
        >
          <p class="label text-muted">
            ({SITE_TAGLINE} – {HOME_CITY} / cała Polska)
          </p>
          <h1
            class="mt-5 text-page leading-[0.95] font-semibold tracking-[-0.035em] text-balance"
          >
            Manager muzyczny dla artystów alternatywnych.
          </h1>
        </div>
        <p
          class="flex items-end bg-ink px-5 py-7 text-[clamp(1.35rem,2.4vw,2rem)] leading-[1.15] font-semibold tracking-[-0.02em] text-white text-balance md:px-8 lg:bg-white lg:text-ink"
        >
          Od pierwszego demo do festiwalowych scen.
        </p>
      </header>

      <section class={row} aria-labelledby="dla-kogo">
        <h2 id="dla-kogo" class={rowLabel}>Dla kogo</h2>
        <div class={`${rowBody} ${prose}`}>
          <p>
            <strong>
              Dla muzyków i zespołów alternatywnych, które mają materiał
              i chcą pracować regularnie, a nie od premiery do premiery.
            </strong>
          </p>
          <p>
            Alt-pop, indie, retro, gitary albo syntezatory – gatunek ma
            mniejsze znaczenie niż to, czy jest co wydawać i czy jest komu
            grać. Nie prowadzę castingów i nie obiecuję wytwórni; obiecuję
            plan, kalendarz i kogoś, kto pilnuje, żeby rzeczy działy się na
            czas.
          </p>
          {
            /* Zdanie pisane ręcznie, nie z ROSTER: potrzebna odmiana („Olę”)
               i relacja między pozycjami (solo + duet), której lista nie niesie.
               Adres bierzemy z ROSTER, żeby link nie rozjechał się ze stroną
               główną. */
          }
          <p>
            Obecnie prowadzę <a
              href={withUtm(ROSTER[0].href, "wspolpraca")}
              target="_blank"
              rel="noopener"
              data-social={ROSTER[0].name}
              class={link}
            >Olę Geppert<span class="sr-only"> (otwiera się w nowej karcie)</span></a> – solo i w duecie z Ioannim. Roster jest mały celowo –
            manager, który ma dwudziestu artystów, nie ma dla nikogo dość
            czasu. Ja chcę mieć go na każdą premierę i każdy koncert.
          </p>
        </div>
      </section>

      <section class={row} aria-labelledby="zakres">
        <h2 id="zakres" class={rowLabel}>Zakres</h2>
        <ul class="divide-y divide-hairline px-5 py-3 md:px-8 lg:px-10">
          {
            SERVICES.map((service) => (
              <li
                id={service.id}
                class="grid scroll-mt-6 gap-2 py-6 md:grid-cols-[minmax(0,0.45fr)_minmax(0,1fr)] md:gap-8"
              >
                <h3 class="flex items-baseline justify-between gap-4 text-row font-semibold md:flex-col md:items-start md:gap-2">
                  <span>{service.label}</span>
                  <span class="label text-muted">({service.no})</span>
                </h3>
                <p class="max-w-[52ch] text-[clamp(1rem,1.4vw,1.125rem)] leading-[1.6] text-body">
                  {service.description}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class={row} aria-labelledby="jak-zaczynamy">
        <h2 id="jak-zaczynamy" class={rowLabel}>Jak zaczynamy</h2>
        <ol class="divide-y divide-hairline px-5 py-3 md:px-8 lg:px-10">
          {
            STEPS.map((step) => (
              <li class="grid gap-2 py-6 md:grid-cols-[minmax(0,0.45fr)_minmax(0,1fr)] md:gap-8">
                <h3 class="flex items-baseline gap-4 text-row font-semibold">
                  <span class="label text-muted">({step.no})</span>
                  <span>{step.title}</span>
                </h3>
                <p class="max-w-[52ch] text-[clamp(1rem,1.4vw,1.125rem)] leading-[1.6] text-body">
                  {step.text}
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class={`${row} border-b-ink`}
        aria-labelledby="pytania"
      >
        <h2 id="pytania" class={rowLabel}>Pytania</h2>
        <dl class="divide-y divide-hairline px-5 py-3 md:px-8 lg:px-10">
          {
            FAQ.map((item) => (
              <div class="py-6">
                <dt class="text-row font-semibold">{item.q}</dt>
                <dd class="mt-3 max-w-[62ch] text-[clamp(1rem,1.4vw,1.125rem)] leading-[1.6] text-body">
                  {item.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section
        class="flex flex-col gap-5 px-5 py-8 md:flex-row md:items-center md:justify-between md:px-8"
      >
        <div>
          <h2 class="label text-muted">Kontakt</h2>
          <p class="mt-3 text-xl font-semibold">
            Masz materiał i chcesz o nim porozmawiać?
          </p>
        </div>
        <EmailLink
          class="label self-start border border-ink px-5 py-4 transition-colors hover:bg-ink hover:text-white md:self-auto"
        >
          Napisz do mnie <span aria-hidden="true">↗</span>
        </EmailLink>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
