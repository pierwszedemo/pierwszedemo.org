---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { ACCESSIBILITY_PATH, CONTACT_EMAIL, FOUNDATION, SITE_HOST, SITE_NAME, SITE_URL } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

/*
 * Deklaracja dostępności. Ustawa z 4 kwietnia 2019 r. obejmuje organizację
 * pozarządową dopiero wtedy, gdy realizuje zadanie publiczne finansowane
 * w ponad połowie ze środków publicznych – czyli przy pierwszej dotacji
 * miasta albo ministerstwa. Lepiej mieć deklarację od początku, niż
 * dopisywać ją w dniu podpisania umowy. Układ i terminy zgodne z WCAG 2.1
 * na poziomie AA, do którego odsyła ustawa.
 */
const PUBLISHED = "2026-10-09";
const REVIEWED = "2026-10-09";

const SECTIONS = [
	{
		title: "Stan",
		paragraphs: [
			`${SITE_NAME} zobowiązuje się zapewnić dostępność strony ${SITE_HOST} zgodnie z ustawą z dnia 4 kwietnia 2019 r. o dostępności cyfrowej stron internetowych i aplikacji mobilnych podmiotów publicznych. Niniejsze oświadczenie dotyczy strony ${SITE_URL}.`,
			"Strona jest zgodna z ustawą. Wszystkie treści są dostępne z klawiatury, mają widoczny fokus, link „Przejdź do treści” na początku każdej strony pozwala pominąć nawigację, nagłówki tworzą logiczną strukturę, zdjęcia mają opisy alternatywne, a kontrast tekstu do tła przekracza 7:1. Jedynym ruchem na stronie jest animacja tytułu na stronie cyklu koncertów – wyłącza ją ustawienie systemowe ograniczenia ruchu.",
		],
	},
	{
		title: "Przygotowanie",
		paragraphs: [
			`Deklarację sporządzono dnia ${PUBLISHED}, na podstawie samooceny przeprowadzonej przez fundację. Ostatni przegląd: ${REVIEWED}.`,
			"Na stronie można używać standardowych skrótów klawiaturowych przeglądarki. Nie ma skrótów własnych, które mogłyby wchodzić w konflikt z technologiami wspomagającymi.",
		],
	},
	{
		title: "Informacje zwrotne",
		paragraphs: [
			`Jeśli coś na stronie jest niedostępne, napisz na ${CONTACT_EMAIL}. Tą samą drogą możesz poprosić o udostępnienie informacji w innej formie, np. o odczytanie treści albo przesłanie jej w formacie dostępnym. Odpowiadamy w ciągu 7 dni; jeśli to niemożliwe, podajemy termin, nie dłuższy niż 2 miesiące.`,
			"Jeżeli odmówimy albo nie dotrzymamy terminu, przysługuje Ci skarga do fundacji, a po wyczerpaniu tej drogi – wniosek do Rzecznika Praw Obywatelskich (bip.brpo.gov.pl).",
		],
	},
	{
		title: "Dostępność architektoniczna",
		paragraphs: [
			`Fundacja nie prowadzi biura obsługi – siedziba (${FOUNDATION.street}, ${FOUNDATION.postalCode} ${FOUNDATION.city}) jest adresem rejestrowym. Koncerty i wydarzenia odbywają się w salach partnerów; informację o dostępności konkretnej sali podajemy przy każdym wydarzeniu.`,
		],
	},
] as const;
---

<BaseLayout
  title={`Deklaracja dostępności – ${SITE_NAME}`}
  description={`Deklaracja dostępności cyfrowej strony ${SITE_HOST}: zgodność z WCAG 2.1 AA, kontakt w sprawie dostępności, tryb skargi.`}
  canonicalPath={ACCESSIBILITY_PATH}
  dateModified={REVIEWED}
>
  <div class="flex min-h-dvh flex-col">
    <Nav />
    <main id="tresc" class="flex-1">
      <header
        class="flex flex-col gap-6 border-b border-ink px-5 pt-10 pb-9 md:flex-row md:items-end md:justify-between md:px-8 md:pt-13"
      >
        <h1 class="font-serif text-page leading-[0.95] tracking-[-0.02em]">
          Deklaracja<br />dostępności
        </h1>
        <p class="label text-muted md:text-right">Przegląd: {REVIEWED}</p>
      </header>
      {
        SECTIONS.map((section) => (
          <section class="grid border-b border-hairline md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:grid-aside-left">
            <h2 class="label px-5 pt-6 text-muted md:border-r md:border-hairline md:px-8 md:py-9">
              {section.title}
            </h2>
            <div class="flex max-w-[68ch] flex-col gap-4 px-5 py-6 md:px-10 md:py-9">
              {section.paragraphs.map((paragraph) => (
                <p class="text-[15.5px] leading-[1.7] text-body">{paragraph}</p>
              ))}
            </div>
          </section>
        ))
      }
    </main>
    <Footer />
  </div>
</BaseLayout>
