---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import EmailLink from "../components/EmailLink.astro";
import SupportBand from "../components/SupportBand.astro";
import { getSortedNews, isoDate } from "../collections";
import {
  FOUNDATION_PATH,
  HOME_CITY,
  NEWS_KINDS,
  NEWS_PATH,
  SITE_NAME,
  SITE_TAGLINE,
  withUtm,
} from "../consts";
import { ACTIVITIES, HOMEPAGE, PROJECTS } from "../strony";
import { fixHanging } from "../typography";

// Trzy ostatnie aktualności – strona główna ma pokazywać, że fundacja żyje,
// a nie dublować listę.
const news = (await getSortedNews()).slice(0, 3);
---

{
  /* Tytuł: nazwa fundacji z przodu, bo to pod nią ma być znajdowana; fraza
     „twórców muzycznych” i miasto po kresce, w limicie ~60 znaków. */
}
<BaseLayout
  title={`${SITE_NAME} – wsparcie młodych twórców muzycznych, ${HOME_CITY}`}
  schemaPageType="ProfilePage"
>
  <div class="flex min-h-dvh flex-col">
    <Nav />

    <main class="flex flex-1 flex-col">
      <!-- Pasmo hero: tekst + czarna komórka z projektami. Prawa kolumna to
           kolumna boczna siatki (5 z 16 modułów) – jej krawędź jest
           przedłużeniem ostatniej linii nawigacji. -->
      <div class="grid flex-1 md:grid-aside-right">
        <div
          class="flex min-w-0 flex-col justify-between gap-14 border-b border-ink px-5 py-12 md:border-r md:border-b-0 md:px-8 md:pt-16 md:pb-11"
        >
          <div>
            {
              /* Nagłówkiem strony jest nadtytuł, nie slogan: „Fundacja Pierwsze
                 Demo – Wsparcie młodych twórców muzycznych – Gdańsk" niesie
                 frazy, pod które ta strona ma się wyświetlać, a slogan nie
                 niesie żadnej. Wizualnie h1 zostaje małą etykietą monospace,
                 a slogan dalej jest największym tekstem na stronie. */
            }
            <h1 class="label text-muted">
              ({SITE_NAME} – {SITE_TAGLINE} – {HOME_CITY})
            </h1>
            <p
              class="mt-6 text-hero leading-[0.98] font-semibold tracking-[-0.035em] text-balance md:mt-[26px]"
            >
              {
                /* Nowa linia w polu „Slogan” w Tinie = złamanie wiersza, ale
                   tylko od md – na telefonie slogan łamie się sam. */
                HOMEPAGE.slogan.split("\n").map((line, index) => (
                  <>
                    {index > 0 && <> <br class="hidden md:inline" /></>}
                    {fixHanging(line)}
                  </>
                ))
              }
            </p>
          </div>

          <div class="flex flex-col gap-7">
            <p class="max-w-[44ch] text-lg leading-[1.55] text-body">
              {fixHanging(HOMEPAGE.intro)}
            </p>
            <ul
              class="flex flex-col gap-3 font-mono text-[13px] leading-none font-medium tracking-[0.14em] uppercase sm:flex-row sm:flex-wrap sm:gap-x-9 sm:gap-y-3"
            >
              {
                ACTIVITIES.map((activity) => (
                  <li>
                    <a
                      href={`${FOUNDATION_PATH}#${activity.id}`}
                      class="underline decoration-1 underline-offset-4"
                    >
                      ({activity.no}) {activity.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Projekty w toku zamiast zdjęcia: strona fundacji pokazuje, co się
             dzieje, nie kto za nią stoi – ludzie są na /fundacja. -->
        <section
          class="flex flex-col justify-between gap-10 bg-ink px-5 py-7 text-white md:px-8 md:py-10"
          aria-labelledby="teraz"
        >
          <h2 id="teraz" class="label text-white/60">Teraz</h2>
          <ul class="flex flex-col gap-6">
            {
              PROJECTS.map((project) => {
                const external = project.href.startsWith("http");
                return (
                  <li>
                    <a
                      href={external ? withUtm(project.href, "teraz") : project.href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noopener" : undefined}
                      class="group flex flex-col gap-1.5"
                    >
                      <span class="text-roster font-semibold tracking-[-0.02em] underline decoration-1 underline-offset-[6px] group-hover:decoration-2">
                        {fixHanging(project.name)}
                      </span>
                      <span class="label text-white/60">
                        {fixHanging(project.meta)}
                        {external && <span class="sr-only"> (otwiera się w nowej karcie)</span>}
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>
      </div>

      <!-- Aktualności + kontakt. Linia 8 = środek strony. -->
      <div class="grid border-t border-ink md:grid-cols-2">
        <section
          class="flex flex-col gap-2.5 border-b border-hairline px-5 pt-6 pb-0 md:border-r md:border-b-0 md:px-8"
          aria-labelledby="ostatnie"
        >
          <h2 id="ostatnie" class="label text-muted">
            <a href={NEWS_PATH}>Aktualności</a>
          </h2>
          {/* Wiersze odwracają się na hover jak na listach wpisów. Ujemny
              margines wypycha czarne tło do krawędzi komórki, bo sekcja ma
              własny padding, a pasek ma sięgać linii siatki, nie tekstu. */}
          <ul class="flex flex-col divide-y divide-hairline">
            {
              news.map((entry) => (
                <li>
                  <a
                    href={`${NEWS_PATH}/${entry.id}`}
                    class="group -mx-5 flex flex-col gap-1.5 px-5 py-4 transition-colors hover:bg-ink hover:text-white focus-visible:bg-ink focus-visible:text-white focus-visible:outline-white focus-visible:outline-offset-[-4px] md:-mx-8 md:px-8"
                  >
                    <span class="text-row font-semibold tracking-[-0.02em] text-balance">
                      {fixHanging(entry.data.title)}
                    </span>
                    <span class="label text-muted group-hover:text-white/70 group-focus-visible:text-white/70">
                      <time datetime={isoDate(entry.data.date)}>
                        {isoDate(entry.data.date)}
                      </time>{" "}
                      · {NEWS_KINDS[entry.data.kind]}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="flex flex-col gap-2.5 px-5 py-6 md:px-8">
          <h2 class="label text-muted">Kontakt</h2>
          <EmailLink
            class="text-[clamp(1.125rem,3.2vw,1.625rem)] font-semibold break-all underline decoration-2 underline-offset-[6px]"
          />
          <p class="mt-2 max-w-[40ch] text-sm leading-[1.6] text-body">
            {fixHanging(HOMEPAGE.contact)}
          </p>
        </section>
      </div>
    </main>

    <SupportBand />
    <Footer />
  </div>
</BaseLayout>
