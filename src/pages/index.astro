---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { getSortedArticles, getSortedNews } from "../collections";
import EmailLink from "../components/EmailLink.astro";
import Footer from "../components/Footer.astro";
import HeroCollage from "../components/home/HeroCollage.astro";
import PostCard from "../components/home/PostCard.astro";
import HomeDolacz from "../components/islands/HomeDolacz.astro";
import HomeDzialania from "../components/islands/HomeDzialania.astro";
import HomeHero from "../components/islands/HomeHero.astro";
import HomeKontakt from "../components/islands/HomeKontakt.astro";
import HomeONas from "../components/islands/HomeONas.astro";
import HomeTeraz from "../components/islands/HomeTeraz.astro";
import { wrappers } from "../components/islands/wrappers";
import Nav from "../components/Nav.astro";
import { HOME_CITY, KNOWLEDGE_PATH, NEWS_KINDS, NEWS_PATH, SITE_NAME } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ACTIVITIES_DOC, FOUNDERS_DOC, HOMEPAGE_DOC } from "../strony";

// Trzy najnowsze wpisy z obu działów naraz – strona główna ma pokazywać, że
// fundacja żyje, a nie dublować list. Wpis z bazy wiedzy dostaje etykietę
// działu, aktualność – swój rodzaj („Relacja”, „Ogłoszenie”).
const latest = [
	...(await getSortedNews()).map((entry) => ({
		entry,
		href: `${NEWS_PATH}/${entry.id}`,
		label: NEWS_KINDS[entry.data.kind],
	})),
	...(await getSortedArticles()).map((entry) => ({
		entry,
		href: `${KNOWLEDGE_PATH}/${entry.id}`,
		label: "Wiedza",
	})),
]
	.sort((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime())
	.slice(0, 3);

const sectionHeading = "font-serif text-page leading-[0.95] tracking-[-0.02em]";
---

{
  /* Tytuł: nazwa fundacji z przodu, bo to pod nią ma być znajdowana; fraza
     „twórców muzycznych” i miasto po kresce, w limicie ~60 znaków. */
}
<BaseLayout
  title={`${SITE_NAME} – wsparcie młodych twórców muzycznych, ${HOME_CITY}`}
  schemaPageType="ProfilePage"
>
  <Nav />

  {
    /* Pasma z tłem na całą szerokość, treść w kontenerze `wrap` – stąd
       `max-w-none` zdejmujące kontener, który <main> ma na podstronach.
       Stopień 17 px jak w makiecie – podstrony zostają przy 16.
       Wyspy <TinaIsland> to regiony, które edytor Tiny odświeża na żywo
       (src/islands.ts). Produkcyjny HTML dostaje przy każdej skrypt, który
       nic nie robi poza iframe'em /admin. */
  }
  <main id="tresc" class="max-w-none text-[17px] leading-[1.55]">
    <div class="wrap flex flex-wrap items-center gap-14 pt-6 pb-20 md:pt-10 md:pb-28">
      <TinaIsland name="home-hero" wrapper={wrappers["home-hero"]} primary>
        <HomeHero home={HOMEPAGE_DOC} />
      </TinaIsland>
      <HeroCollage />
    </div>

    <section id="kim-jestesmy" class="bg-ink text-white" aria-labelledby="kim-jestesmy-naglowek">
      <div class="wrap flex flex-wrap items-start gap-x-20 gap-y-8 py-20 md:py-30">
        <h2 id="kim-jestesmy-naglowek" class="label flex-[0_0_12.5rem] pt-3.5 text-fog">Kim jesteśmy</h2>
        <TinaIsland name="home-o-nas" wrapper={wrappers["home-o-nas"]}>
          <HomeONas home={HOMEPAGE_DOC} founders={FOUNDERS_DOC} />
        </TinaIsland>
      </div>
    </section>

    <section id="co-robimy" class="wrap py-20 md:py-30" aria-labelledby="co-robimy-naglowek">
      <TinaIsland name="home-dzialania" wrapper={wrappers["home-dzialania"]}>
        <HomeDzialania home={HOMEPAGE_DOC} activities={ACTIVITIES_DOC} />
      </TinaIsland>
    </section>

    <section class="wrap pb-20 md:pb-30" aria-labelledby="dzieje-naglowek">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <h2 id="dzieje-naglowek" class={sectionHeading}>Co się <em>dzieje</em></h2>
        <a href={NEWS_PATH} class="font-semibold text-blue underline-offset-4 hover:underline">
          Wszystkie aktualności <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] gap-6">
        {
          latest.map(({ entry, href, label }, index) => (
            <li>
              <PostCard href={href} title={entry.data.title} date={entry.data.date} label={label} variant={index} />
            </li>
          ))
        }
      </ul>
    </section>

    {/* Projekty w toku – dawny czarny panel „Teraz” z hero. Strona fundacji
        pokazuje, co się dzieje, nie kto za nią stoi. */}
    <section class="wrap pb-20 md:pb-30" aria-label="Teraz">
      <TinaIsland name="home-teraz" wrapper={wrappers["home-teraz"]}>
        <HomeTeraz home={HOMEPAGE_DOC} />
      </TinaIsland>
    </section>

    <section id="dolacz" class="border-y border-hairline bg-white" aria-labelledby="dolacz-naglowek">
      <TinaIsland name="home-dolacz" wrapper={wrappers["home-dolacz"]}>
        <HomeDolacz home={HOMEPAGE_DOC} />
      </TinaIsland>
    </section>

    <section id="kontakt" class="wrap py-20 md:py-30" aria-labelledby="kontakt-naglowek">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] items-end gap-10">
        <h2 id="kontakt-naglowek" class={sectionHeading}>Po prostu <em>napisz.</em></h2>
        <div class="flex flex-col gap-4">
          <EmailLink
            class="font-serif text-[clamp(1.875rem,3vw,2.75rem)] break-words text-blue underline decoration-1 underline-offset-8 hover:text-blue-deep"
          />
          <TinaIsland name="home-kontakt" wrapper={wrappers["home-kontakt"]}>
            <HomeKontakt home={HOMEPAGE_DOC} />
          </TinaIsland>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
