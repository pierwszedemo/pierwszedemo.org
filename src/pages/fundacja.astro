---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import ola from "../assets/dzwieki-efemeryczne/ola-geppert.jpg";
import michal from "../assets/michal.jpg";
import EmailLink from "../components/EmailLink.astro";
import Footer from "../components/Footer.astro";
import HeroPhoto from "../components/HeroPhoto.astro";
import FundacjaDzialania from "../components/islands/FundacjaDzialania.astro";
import FundacjaMisja from "../components/islands/FundacjaMisja.astro";
import FundacjaNaglowek from "../components/islands/FundacjaNaglowek.astro";
import Fundator from "../components/islands/Fundator.astro";
import { wrappers } from "../components/islands/wrappers";
import Nav from "../components/Nav.astro";
import SupportBand from "../components/SupportBand.astro";
import {
	CONTACT_EMAIL,
	FOUNDATION,
	FOUNDATION_PATH,
	GOALS,
	HOME_CITY,
	registryValue,
	SITE_NAME,
	SITE_URL,
	STATUTE_PATH,
	SUPPORT_PATH,
} from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbJsonLd } from "../schema";
import { ACTIVITIES_DOC, FOUNDATION_PAGE_DOC, FOUNDERS, FOUNDERS_DOC } from "../strony";
import { fixHanging } from "../typography";

/*
 * Jedna długa strona o fundacji: misja, cele statutowe, działania, ludzie,
 * dane rejestrowe, statut i sprawozdania. Nawigacja ma trzy pozycje, więc
 * wszystko, co o organizacji, mieszka tu – pod kotwicami, do których linkują
 * hero, stopka i llms.txt.
 */
const canonical = new URL(FOUNDATION_PATH, SITE_URL).href;
const breadcrumb = breadcrumbJsonLd(
	[
		{ name: "Start", path: "/" },
		{ name: "Fundacja", path: FOUNDATION_PATH },
	],
	canonical,
);

const registry = [
	{ label: "Nazwa", value: FOUNDATION.name },
	{
		label: "Siedziba",
		value: `${FOUNDATION.street}, ${FOUNDATION.postalCode} ${FOUNDATION.city}`,
	},
	{ label: "KRS", value: registryValue(FOUNDATION.krs) },
	{ label: "NIP", value: registryValue(FOUNDATION.nip) },
	{ label: "REGON", value: registryValue(FOUNDATION.regon) },
	{ label: "Sąd rejestrowy", value: FOUNDATION.court },
	{ label: "Nadzór", value: FOUNDATION.supervision },
	{ label: "Forma", value: "fundacja" },
] as const;

const photos = {
	michal: {
		src: michal,
		alt: "Michał Miszczyszyn w niebieskiej kurtce, w tle panorama Bergen",
		position: "object-[center_35%]",
	},
	ola: {
		src: ola,
		alt: "Ola Geppert na scenie – czarno-białe zdjęcie: chustka na głowie, długie czarne rękawiczki, mikrofon trzymany oburącz przy ustach",
		position: "object-top",
	},
} as const;

import { item, itemText, link, list, prose, row, rowBody, rowLabel } from "../styles/fundacja";
---

<BaseLayout
  title={`O fundacji – cele, działania, zarząd | ${SITE_NAME}`}
  description={`${SITE_NAME} z ${HOME_CITY}a: cele statutowe, programy, fundatorzy i zarząd, dane rejestrowe, statut i sprawozdania.`}
  canonicalPath={FOUNDATION_PATH}
  extraJsonLd={[breadcrumb]}
>
  <div class="flex min-h-dvh flex-col">
    <Nav active="Fundacja" />

    <main id="tresc" class="flex-1">
      <TinaIsland name="fundacja-naglowek" wrapper={wrappers["fundacja-naglowek"]} primary>
        <FundacjaNaglowek page={FOUNDATION_PAGE_DOC} />
      </TinaIsland>

      <section class={row} aria-labelledby="misja">
        <h2 id="misja" class={rowLabel}>Misja</h2>
        <TinaIsland name="fundacja-misja" wrapper={wrappers["fundacja-misja"]}>
          <FundacjaMisja page={FOUNDATION_PAGE_DOC} />
        </TinaIsland>
      </section>

      <section class={row} aria-labelledby="dzialania">
        <h2 id="dzialania" class={rowLabel}>Działania</h2>
        <TinaIsland name="fundacja-dzialania" wrapper={wrappers["fundacja-dzialania"]}>
          <FundacjaDzialania activities={ACTIVITIES_DOC} />
        </TinaIsland>
      </section>

      <section class={row} aria-labelledby="cele">
        <h2 id="cele" class={rowLabel}>Cele statutowe</h2>
        <div class={rowBody}>
          <p class={`${itemText} mb-5`}>
            Z § 5 <a href={STATUTE_PATH} class={link}>statutu</a>. Celami
            Fundacji są:
          </p>
          <ol class="flex max-w-[62ch] flex-col gap-3">
            {
              GOALS.map((goal, index) => (
                <li class={`flex gap-4 ${itemText}`}>
                  <span class="label shrink-0 pt-[0.35em] text-muted">
                    ({String(index + 1).padStart(2, "0")})
                  </span>
                  <span>{fixHanging(goal)}{index < GOALS.length - 1 ? ";" : "."}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Zespół: fundatorzy, zarazem cały Zarząd. Zdjęcie w kolumnie
           bocznej, bio od linii 5 – ten sam szkielet, co strona wpisu. -->
      <section id="zespol" aria-labelledby="zespol-naglowek">
        <h2
          id="zespol-naglowek"
          class="label border-b border-hairline px-5 pt-7 pb-6 text-muted md:px-8"
        >
          Fundatorzy i Zarząd
        </h2>
        {
          FOUNDERS.map((person) => {
            const photo = photos[person.id];
            return (
              <article
                id={person.id}
                class="grid border-b border-hairline md:grid-aside-left"
              >
                <HeroPhoto
                  src={photo.src}
                  alt={photo.alt}
                  caption={person.name}
                  position={photo.position}
                  class="aspect-[4/5] border-b border-hairline md:aspect-auto md:min-h-[30rem] md:border-r md:border-b-0"
                />
                <TinaIsland
                  name="fundator"
                  wrapper={wrappers.fundator}
                  params={{ id: person.id }}
                >
                  <Fundator person={FOUNDERS_DOC[person.id]} />
                </TinaIsland>
              </article>
            );
          })
        }
      </section>

      <section class={row} aria-labelledby="dane">
        <h2 id="dane" class={rowLabel}>Dane rejestrowe</h2>
        <dl class="divide-y divide-hairline px-5 py-3 md:px-8 lg:px-10">
          {
            registry.map((entry) => (
              <div class={`${item} py-4`}>
                <dt class="label pt-[0.2em] text-muted">{entry.label}</dt>
                <dd class={itemText}>{entry.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class={row} aria-labelledby="dokumenty">
        <h2 id="dokumenty" class={rowLabel}>Dokumenty</h2>
        <ul class={list}>
          <li class={item}>
            <h3 class="text-row font-semibold">Statut</h3>
            <p class={itemText}>
              Pełny tekst statutu:{' '}
              <a href={STATUTE_PATH} class={link}>
                statut Fundacji Pierwsze Demo <span aria-hidden="true">→</span>
              </a>
            </p>
          </li>
          <li class={item} id="sprawozdania">
            <h3 class="text-row font-semibold">Sprawozdania</h3>
            <div class={`flex flex-col gap-3 ${itemText}`}>
              <p>
                Co roku Zarząd składa ministrowi sprawozdanie z działalności
                fundacji i publikuje je tutaj. Pierwsze – za rok 2026 – ukaże
                się w 2027 roku.
              </p>
            </div>
          </li>
        </ul>
      </section>

      <section class={`${row} border-b-ink`} aria-labelledby="wsparcie">
        <h2 id="wsparcie" class={rowLabel}>Finansowanie</h2>
        <div class={`${rowBody} ${prose}`}>
          <p>
            Fundacja utrzymuje się z darowizn, dotacji i grantów oraz
            z odpłatnej działalności pożytku publicznego – biletowanych
            koncertów i warsztatów – sprzedawanych poniżej kosztów.
          </p>
          <p>
            Fundacja nie prowadzi
            działalności gospodarczej, a członkowie Zarządu nie pobierają
            wynagrodzenia za pełnienie funkcji.
          </p>
          <p>
            <a href={SUPPORT_PATH} class={link}>
              Jak wesprzeć fundację <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>

      <section
        class="flex flex-col gap-5 px-5 py-8 md:flex-row md:items-center md:justify-between md:px-8"
      >
        <div>
          <h2 class="label text-muted">Kontakt</h2>
          <p class="mt-3 text-xl font-semibold">
            Masz pytanie, projekt albo chcesz z nami pracować?
          </p>
        </div>
        {/* Adres dosłownie, nie „Napisz do nas": nawigacja nie ma komórki
            Kontakt, więc to tutaj ktoś szuka adresu. Wersaliki robi CSS –
            w DOM-ie i po skopiowaniu adres zostaje małymi literami. */}
        <EmailLink
          class="label self-start border border-ink px-5 py-4 transition-colors hover:bg-ink hover:text-white md:self-auto"
        >
          {CONTACT_EMAIL} <span aria-hidden="true">↗</span>
        </EmailLink>
      </section>
    </main>

    <SupportBand />
    <Footer />
  </div>
</BaseLayout>
