---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Footer from "../components/Footer.astro";
import HeroPhoto from "../components/HeroPhoto.astro";
import FundacjaDzialania from "../components/islands/FundacjaDzialania.astro";
import FundacjaMisja from "../components/islands/FundacjaMisja.astro";
import FundacjaNaglowek from "../components/islands/FundacjaNaglowek.astro";
import Fundator from "../components/islands/Fundator.astro";
import { wrappers } from "../components/islands/wrappers";
import Nav from "../components/Nav.astro";
import Section from "../components/Section.astro";
import SupportBand from "../components/SupportBand.astro";
import {
	FOUNDATION,
	FOUNDATION_PATH,
	GOALS,
	HOME_CITY,
	pageOgImage,
	registryValue,
	SITE_NAME,
	SITE_URL,
	STATUTE_PATH,
	SUPPORT_PATH,
} from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { FOUNDER_PHOTOS } from "../photos";
import { breadcrumbJsonLd } from "../schema";
import { ACTIVITIES_DOC, FOUNDATION_PAGE_DOC, FOUNDERS, FOUNDERS_DOC } from "../strony";
import { fixHanging } from "../typography";

/*
 * Jedna długa strona o fundacji: misja, cele statutowe, działania, ludzie,
 * dane rejestrowe, statut i sprawozdania. Wszystko, co o organizacji,
 * mieszka tu – pod kotwicami, do których linkują nawigacja („O nas”,
 * „Co robimy”), strona główna, stopka, podpisy wpisów i llms.txt. Kotwica
 * stoi na sekcji, nie na nagłówku (patrz Section.astro).
 */
const canonical = new URL(FOUNDATION_PATH, SITE_URL).href;
const breadcrumb = breadcrumbJsonLd(
	[
		{ name: "Start", path: "/" },
		{ name: "Fundacja", path: FOUNDATION_PATH },
	],
	canonical,
);

const registry = [
	{ label: "Nazwa", value: FOUNDATION.name },
	{
		label: "Siedziba",
		value: `${FOUNDATION.street}, ${FOUNDATION.postalCode} ${FOUNDATION.city}`,
	},
	{ label: "KRS", value: registryValue(FOUNDATION.krs) },
	{ label: "NIP", value: registryValue(FOUNDATION.nip) },
	{ label: "REGON", value: registryValue(FOUNDATION.regon) },
	{ label: "Sąd rejestrowy", value: FOUNDATION.court },
	{ label: "Nadzór", value: FOUNDATION.supervision },
	{ label: "Forma", value: "fundacja" },
] as const;
---

<BaseLayout
  title={`O fundacji – cele, działania, zarząd | ${SITE_NAME}`}
  description={`${SITE_NAME} z ${HOME_CITY}a: cele statutowe, programy, fundatorzy i zarząd, dane rejestrowe, statut i sprawozdania.`}
  canonicalPath={FOUNDATION_PATH}
  ogImage={pageOgImage("fundacja")}
  extraJsonLd={[breadcrumb]}
>
  <Nav active="O nas" />

  <main id="tresc">
    <TinaIsland name="fundacja-naglowek" wrapper={wrappers["fundacja-naglowek"]} primary>
      <FundacjaNaglowek page={FOUNDATION_PAGE_DOC} />
    </TinaIsland>

    {/* Ciemne pasmo jak „Kim jesteśmy” na stronie głównej: etykieta z lewej,
        zdanie o misji wielkim serifem, reszta drobniej. */}
    <section id="misja" class="bg-ink text-white" aria-labelledby="misja-naglowek">
      <div class="wrap flex flex-wrap items-start gap-x-20 gap-y-8 py-20 md:py-30">
        <h2 id="misja-naglowek" class="label flex-[0_0_12.5rem] pt-3 text-fog">Misja</h2>
        <TinaIsland name="fundacja-misja" wrapper={wrappers["fundacja-misja"]}>
          <FundacjaMisja page={FOUNDATION_PAGE_DOC} />
        </TinaIsland>
      </div>
    </section>

    <Section id="dzialania" heading="Co robimy">
      <TinaIsland name="fundacja-dzialania" wrapper={wrappers["fundacja-dzialania"]}>
        <FundacjaDzialania activities={ACTIVITIES_DOC} />
      </TinaIsland>
    </Section>

    <Section id="cele" heading="Cele statutowe" tone="white">
      <Fragment slot="intro">
        Z § 5 <a href={STATUTE_PATH} class="text-link">statutu</a>. Celami Fundacji są:
      </Fragment>
      <ol class="grid gap-x-12 md:grid-cols-2">
        {
          GOALS.map((goal, index) => (
            <li class="flex gap-5 border-t border-hairline py-5 text-body">
              <span class="shrink-0 pt-0.5 font-mono text-[15px] text-muted">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>
                {fixHanging(goal)}
                {index < GOALS.length - 1 ? ";" : "."}
              </span>
            </li>
          ))
        }
      </ol>
    </Section>

    {/* Fundatorzy, zarazem cały Zarząd. Zdjęcie i bio na przemian po lewej
        i po prawej, żeby dwie osoby nie zlały się w jedną kolumnę tekstu. */}
    <Section id="zespol" heading="Fundatorzy i Zarząd">
      <div class="flex flex-col gap-16 md:gap-24">
        {
          FOUNDERS.map((person, index) => {
            const photo = FOUNDER_PHOTOS[person.id];
            const flipped = index % 2 === 1;
            return (
              <article
                id={person.id}
                class:list={[
                  "grid scroll-mt-6 items-start gap-8 md:gap-16",
                  flipped
                    ? "md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]"
                    : "md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]",
                ]}
              >
                <HeroPhoto
                  src={photo.src}
                  alt={photo.alt}
                  caption={person.name}
                  position={photo.position}
                  class:list={["aspect-[4/5]", flipped && "md:order-last"]}
                />
                <TinaIsland name="fundator" wrapper={wrappers.fundator} params={{ id: person.id }}>
                  <Fundator person={FOUNDERS_DOC[person.id]} />
                </TinaIsland>
              </article>
            );
          })
        }
      </div>
    </Section>

    <Section id="dane" heading="Dane rejestrowe" tone="white">
      <dl class="border-t-[1.5px] border-ink">
        {
          registry.map((entry) => (
            <div class="grid gap-1 border-b border-hairline py-4 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-8">
              <dt class="label pt-1 text-muted">{entry.label}</dt>
              <dd class="text-lg">{fixHanging(entry.value)}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section id="dokumenty" heading="Statut i sprawozdania">
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] gap-5">
        <li class="flex min-h-72 flex-col justify-between gap-8 rounded-[28px] bg-lime p-8">
          <h3 class="font-serif text-[40px] leading-none">Statut</h3>
          <div class="flex flex-col gap-4">
            <p>Pełny tekst statutu: cele i zasady działania, majątek, Zarząd, sprawozdawczość.</p>
            <a href={STATUTE_PATH} class="btn btn-ink self-start">Przeczytaj statut</a>
          </div>
        </li>
        <li
          id="sprawozdania"
          class="flex min-h-72 scroll-mt-6 flex-col justify-between gap-8 rounded-[28px] border border-hairline bg-white p-8"
        >
          <h3 class="font-serif text-[40px] leading-none">Sprawozdania</h3>
          <p class="text-body">
            Co roku Zarząd składa ministrowi sprawozdanie z działalności fundacji i publikuje je
            tutaj. Pierwsze – za rok 2026 – ukaże się w 2027 roku.
          </p>
        </li>
      </ul>
    </Section>

    <Section id="wsparcie" heading="Finansowanie" class="!pb-0">
      <div class="flex max-w-[62ch] flex-col gap-5 text-xl leading-[1.55] text-body">
        <p>
          Fundacja utrzymuje się z darowizn, dotacji i grantów oraz z odpłatnej działalności pożytku
          publicznego – biletowanych koncertów i warsztatów – sprzedawanych poniżej kosztów.
        </p>
        <p>
          Fundacja nie prowadzi działalności gospodarczej, a członkowie Zarządu nie pobierają
          wynagrodzenia za pełnienie funkcji.
        </p>
        <p>
          <a href={SUPPORT_PATH} class="text-link font-semibold">
            Jak wesprzeć fundację <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </Section>

    <ContactBlock heading="Po prostu napisz." text="Masz pytanie, projekt albo chcesz z nami pracować?" />
  </main>

  <SupportBand />
  <Footer />
</BaseLayout>
