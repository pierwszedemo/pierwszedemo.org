---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Byline from "../../components/Byline.astro";
import { getSortedArticles, getRoutedArticles, nextListed, type Article } from "../../collections";
import { KNOWLEDGE_PATH } from "../../consts";

interface Props {
  entry: Article;
  next?: Article;
}

// Redundantne przy `output: "static"`, ale zostaje jako zabezpieczenie: gdyby
// serwis wrócił do trybu server, bez tego trasa dynamiczna wypadłaby z sitemapy
// (integracja umie wyliczyć tylko prerenderowane).
export const prerender = true;

export async function getStaticPaths() {
  const listed = await getSortedArticles();
  return (await getRoutedArticles()).map((entry) => ({
    params: { slug: entry.id },
    // Lista jest posortowana malejąco, więc „następny" w czytaniu to starszy wpis.
    props: { entry, next: nextListed(entry, listed) },
  }));
}

const { entry, next } = Astro.props;
---

<ArticleLayout
  entry={entry}
  section={{ label: "Wiedza", href: KNOWLEDGE_PATH }}
  meta={entry.data.category}
  twoColumns={entry.data.kind === "notatka"}
  next={next && { href: `${KNOWLEDGE_PATH}/${next.id}`, title: next.data.title }}
  keywords={[entry.data.keyphrase, entry.data.category].filter(
    (keyword): keyword is string => Boolean(keyword),
  )}
  oldestLabel="To najstarszy wpis w bazie wiedzy."
>
  <Byline slot="aside" authors={entry.data.authors} updated={entry.data.updated} />
</ArticleLayout>
