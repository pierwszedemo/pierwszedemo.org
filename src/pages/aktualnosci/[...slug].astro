---
import { getRoutedNews, getSortedNews, type News, nextListed, readingMinutes } from "../../collections";
import Byline from "../../components/Byline.astro";
import { NEWS_KINDS, NEWS_PATH } from "../../consts";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

interface Props {
	entry: News;
	next?: News;
}

export const prerender = true;

export async function getStaticPaths() {
	const listed = await getSortedNews();
	return (await getRoutedNews()).map((entry) => ({
		params: { slug: entry.id },
		props: { entry, next: nextListed(entry, listed) },
	}));
}

const { entry, next } = Astro.props;
// Dwie łamy tylko dla krótkich relacji i opinii; rozmowa z `###` co drugi
// akapit jest długa jak przewodnik i czyta się ją w jednej.
const twoColumns = entry.data.kind !== "rozmowa" && readingMinutes(entry) <= 4;
---

<ArticleLayout
  entry={entry}
  section={{ label: "Aktualności", href: NEWS_PATH }}
  meta={NEWS_KINDS[entry.data.kind]}
  twoColumns={twoColumns}
  next={next && { href: `${NEWS_PATH}/${next.id}`, title: next.data.title }}
  keywords={[entry.data.keyphrase, NEWS_KINDS[entry.data.kind]].filter(
    (keyword): keyword is string => Boolean(keyword),
  )}
  oldestLabel="To najstarsza aktualność."
>
  <Byline slot="aside" authors={entry.data.authors} updated={entry.data.updated} />
</ArticleLayout>
