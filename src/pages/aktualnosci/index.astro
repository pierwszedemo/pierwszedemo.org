---
import { getSortedNews, isoDate, readingMinutes } from "../../collections";
import Footer from "../../components/Footer.astro";
import ListRow from "../../components/ListRow.astro";
import Nav from "../../components/Nav.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import SupportBand from "../../components/SupportBand.astro";
import {
	NEWS_KINDS,
	NEWS_PATH,
	ORGANIZATION_ID,
	PAGE_HEADERS,
	pageOgImage,
	SITE_NAME,
	SITE_URL,
	WEBSITE_ID,
} from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { breadcrumbJsonLd, isoDateTime } from "../../schema";
import { authorJsonLd, sectionAuthorJsonLd } from "../../strony";

const entries = await getSortedNews();
// Trzy najnowsze jako karty, jak „Co się dzieje” na stronie głównej, reszta
// jako wiersze. Kolejność ta sama – karty to po prostu początek listy.
const latest = entries.slice(0, 3);
const older = entries.slice(3);
const canonical = new URL(NEWS_PATH, SITE_URL).href;
const entryUrl = (id: string) => new URL(`${NEWS_PATH}/${id}`, SITE_URL).href;

const description =
	"Aktualności Fundacji Pierwsze Demo: koncerty i wydarzenia, relacje, rozmowy z artystami, komunikaty i sprawozdania z projektów.";

const blogJsonLd = {
	"@type": "Blog",
	"@id": `${canonical}#blog`,
	name: `Aktualności – ${SITE_NAME}`,
	description,
	url: canonical,
	inLanguage: "pl",
	author: sectionAuthorJsonLd(entries),
	publisher: { "@id": ORGANIZATION_ID },
	isPartOf: { "@id": WEBSITE_ID },
	blogPost: entries.map((entry) => ({
		"@type": "BlogPosting",
		"@id": `${entryUrl(entry.id)}#post`,
		headline: entry.data.title,
		description: entry.data.lead,
		url: entryUrl(entry.id),
		articleSection: NEWS_KINDS[entry.data.kind],
		datePublished: isoDateTime(entry.data.date),
		dateModified: isoDateTime(entry.data.updated ?? entry.data.date),
		author: authorJsonLd(entry.data.authors),
	})),
};

const itemListJsonLd = {
	"@type": "ItemList",
	"@id": `${canonical}#lista`,
	name: `Aktualności ${SITE_NAME}`,
	numberOfItems: entries.length,
	itemListOrder: "https://schema.org/ItemListOrderDescending",
	itemListElement: entries.map((entry, index) => ({
		"@type": "ListItem",
		position: index + 1,
		url: entryUrl(entry.id),
		name: entry.data.title,
	})),
};

const breadcrumb = breadcrumbJsonLd(
	[
		{ name: "Start", path: "/" },
		{ name: "Aktualności", path: NEWS_PATH },
	],
	canonical,
);
---

<BaseLayout
  title={`Aktualności – ${SITE_NAME}`}
  description={description}
  canonicalPath={NEWS_PATH}
  ogImage={pageOgImage("aktualnosci")}
  schemaPageType="CollectionPage"
  extraJsonLd={[blogJsonLd, itemListJsonLd, breadcrumb]}
>
  <Nav active="Aktualności" />

  <main id="tresc">
    <PageHeader {...PAGE_HEADERS.aktualnosci} />

    <section class="wrap pb-16 md:pb-24" aria-label="Najnowsze">
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(18.75rem,100%),1fr))] gap-6">
        {
          latest.map((entry) => (
            <li>
              <PostCard
                href={`${NEWS_PATH}/${entry.id}`}
                slug={entry.id}
                title={entry.data.title}
                date={entry.data.date}
                label={NEWS_KINDS[entry.data.kind]}
                heading="h2"
              />
            </li>
          ))
        }
      </ul>
    </section>

    {
      older.length > 0 && (
        <section class="wrap pb-16 md:pb-24" aria-labelledby="wczesniej">
          <h2 id="wczesniej" class="mb-8 font-serif text-[clamp(2.25rem,4vw,3.5rem)] leading-none">
            Wcześniej
          </h2>
          <ul class="border-t-[1.5px] border-ink">
            {older.map((entry) => (
              <ListRow
                href={`${NEWS_PATH}/${entry.id}`}
                title={entry.data.title}
                left={isoDate(entry.data.date)}
                leftDatetime={isoDate(entry.data.date)}
                label={NEWS_KINDS[entry.data.kind]}
                sub={`${readingMinutes(entry)} min`}
              />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <SupportBand />
  <Footer />
</BaseLayout>
