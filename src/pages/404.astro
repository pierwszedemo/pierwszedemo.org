---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { KNOWLEDGE_PATH, SITE_NAME } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Nie ma takiej strony – ${SITE_NAME}`}
  description="Pod tym adresem nic nie ma."
  robots="noindex, follow"
>
  <div class="flex min-h-dvh flex-col">
    <Nav />

    <main id="tresc" class="wrap flex flex-1 flex-col justify-center gap-8 py-16">
      <p
        class="flex items-center gap-2.5 self-start rounded-3xl border border-hairline bg-white py-2 px-4 font-mono text-[15px]"
      >
        404 · 00:00
      </p>
      <h1 class="font-serif text-hero leading-[0.92] tracking-[-0.02em] text-balance">
        Nie ma takiej strony.
      </h1>
      <p class="max-w-[44ch] text-xl leading-[1.55] text-body">
        Adres jest błędny albo strona zmieniła miejsce. Zacznij od strony głównej lub zajrzyj do bazy
        wiedzy.
      </p>
      <p class="flex flex-wrap gap-3">
        <a href="/" class="btn btn-lg btn-ink">Strona główna</a>
        <a href={KNOWLEDGE_PATH} class="btn btn-lg btn-ghost">Baza wiedzy</a>
      </p>
    </main>

    <Footer />
  </div>
</BaseLayout>
