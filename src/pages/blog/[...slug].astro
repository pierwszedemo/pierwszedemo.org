---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getSortedPosts, isoDate, type Post } from "../../blog";
import { breadcrumbJsonLd, isoDateTime, wordCount } from "../../schema";
import { fixHanging } from "../../typography";
import { PERSON_ID, SITE_NAME, SITE_URL, WEBSITE_ID } from "../../consts";

interface Props {
  post: Post;
  next?: Post;
}

// Redundantne przy `output: "static"`, ale zostaje jako zabezpieczenie: gdyby
// serwis wrócił do trybu server, bez tego trasa dynamiczna wypadłaby z sitemapy
// (integracja umie wyliczyć tylko prerenderowane).
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    // Lista jest posortowana malejąco, więc „następny" w czytaniu to starszy wpis.
    props: { post, next: posts[index + 1] },
  }));
}

const { post, next } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(`/blog/${post.id}`, SITE_URL).href;
// Przewodniki starzeją się na liczbach, więc po rewizji faktów liczy się data
// aktualizacji – ale data publikacji zostaje, bo porządkuje listę wpisów.
const modified = isoDate(post.data.updated ?? post.data.date);
const ogImage = `/og/${post.id}.png`;
const blogPostingJsonLd = {
  "@type": "BlogPosting",
  "@id": `${canonical}#post`,
  headline: post.data.title,
  description: post.data.lead,
  url: canonical,
  articleSection: post.data.category,
  datePublished: isoDateTime(post.data.date),
  dateModified: isoDateTime(modified),
  inLanguage: "pl",
  author: { "@id": PERSON_ID },
  publisher: { "@id": PERSON_ID },
  isPartOf: { "@id": WEBSITE_ID },
  mainEntityOfPage: { "@id": canonical },
  image: new URL(ogImage, SITE_URL).href,
  wordCount: wordCount(post.body ?? ""),
  // ISO 8601 – ta sama liczba, którą widać w pasku metadanych wpisu.
  timeRequired: `PT${post.data.readingMinutes}M`,
  ...(post.data.keyphrase
    ? { keywords: [post.data.keyphrase, post.data.category] }
    : { keywords: [post.data.category] }),
};
const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Start", path: "/" },
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: `/blog/${post.id}` },
  ],
  canonical,
);
---

<BaseLayout
  title={`${post.data.title} – ${SITE_NAME}`}
  description={post.data.lead}
  ogType="article"
  ogImage={ogImage}
  dateModified={modified}
  extraJsonLd={[blogPostingJsonLd, breadcrumb]}
>
  <div class="flex min-h-dvh flex-col">
    <Nav active="Blog" />

    <main class="flex flex-1 flex-col">
      {/* Kolumna „W skrócie" = kolumna boczna siatki, ale nie węższa niż
            21.5 rem: odtwarzacz Spotify potrzebuje 280 px, a padding kolumny
            zabiera 2 × 32 px, a border-r jeszcze 1 px. Od ~1100 px wygrywa siatka. */}
      <article class="flex flex-1 flex-col md:[--post-aside:max(calc(21.5rem_+_1px),var(--aside))]">
        <!-- Pasek metadanych: data / kategoria / czas czytania. Tory 5 / 6 / 5
             z 16 modułów – te same linie co w nawigacji. -->
        <div
          class="label grid grid-cols-2 border-b border-ink text-muted md:grid-cols-[var(--aside)_minmax(0,1fr)_var(--aside)]"
        >
          <div
            class="border-r border-b border-hairline px-5 py-[18px] md:border-b-0 md:px-8"
          >
            <time datetime={isoDate(post.data.date)}>
              {isoDate(post.data.date)}
            </time>
          </div>
          <div
            class="border-b border-hairline px-5 py-[18px] md:border-r md:border-b-0 md:px-8"
          >
            {post.data.category}
          </div>
          <div class="col-span-2 px-5 py-[18px] md:col-span-1 md:px-8">
            {post.data.readingMinutes} min czyt.
          </div>
        </div>

        <!-- Tytuł jest wcięty tak, żeby zaczynał się w osi kolumny z tekstem. -->
        <!-- Wcięcie = szerokość kolumny „W skrócie" + 32 px, żeby tytuł
             zaczynał się w osi tekstu wpisu. -->
        <header
          class="border-b border-ink px-5 py-10 md:px-8 md:pl-[calc(var(--post-aside)_+_2rem)]"
        >
          <h1
            class="max-w-[18ch] text-post leading-[1.02] font-semibold tracking-[-0.03em] text-balance"
          >
            {/* Niełamliwe spacje tylko w tekście widocznym na stronie – w meta,
                JSON-LD, RSS-ie i llms.txt to dane dla maszyn, nie typografia. */}
            {fixHanging(post.data.title)}
          </h1>
        </header>

        {
          /* Wyimek jako osobne pasmo, nie znacznik w treści: korpus wpisu
             dopuszcza tylko akapity, nagłówki, linki, strong i em, a pasmo
             wpada w oko komuś, kto przelatuje stronę wzrokiem – czego samo
             pogrubienie nie robi, bo `strong` to tu tylko waga 600.
             Wcięcie jak w nagłówku, żeby cytat stał w osi tekstu wpisu. */
          post.data.pullquote && (
            <aside class="border-b border-ink px-5 py-10 md:px-8 md:pl-[calc(var(--post-aside)_+_2rem)]">
              <p class="text-row leading-[1.3] font-medium tracking-[-0.01em] text-pretty text-ink">
                {fixHanging(`„${post.data.pullquote}”`)}
              </p>
              {post.data.pullquoteAuthor && (
                <p class="label mt-[18px] text-muted">
                  {post.data.pullquoteAuthor}
                </p>
              )}
            </aside>
          )
        }

        {/* Poniżej md siatka nie ma zadeklarowanych kolumn, a niejawna kolumna
            `auto` rośnie do min-content treści – przy tabeli 800 px wypychała
            całą stronę poza ekran zamiast pozwolić wrapperowi ją przewinąć.
            Stąd jawne `minmax(0, 1fr)` w obu układach i `min-w-0` na komórce. */}
        <div
          class="grid flex-1 grid-cols-[minmax(0,1fr)] md:grid-cols-[var(--post-aside)_minmax(0,1fr)]"
        >
          <aside
            class="border-b border-hairline px-5 py-9 md:border-r md:border-b-0 md:px-8"
          >
            {/* Sticky na wewnętrznym divie, nie na aside: aside musi zostać
                pełnej wysokości, żeby border-r biegł przez całe pasmo treści.
                Tylko od md – poniżej kolumny są ułożone jedna pod drugą.
                top-9 = pionowy padding aside, żeby przyklejona treść stawała
                dokładnie tam, gdzie stoi przed scrollem. */}
            <div class="flex flex-col gap-[18px] md:sticky md:top-9">
            <h2 class="label text-muted">W skrócie</h2>
            <p class="text-xl leading-[1.5] font-medium text-body">
              {fixHanging(post.data.lead)}
            </p>
            {
              /* Grafika wpisu siedzi pod leadem, nie w treści: kolumna „W skrócie"
                 ma już stałą szerokość i sticky, a korpus w dwóch łamach
                 rozerwałby obrazek na granicy kolumny. sizes odpowiada
                 szerokościom aside: 5 modułów siatki, poniżej ~1100 px 21.5 rem,
                 pełna szerokość poniżej md. */
              post.data.image && (
                <Image
                  src={post.data.image}
                  alt={post.data.imageAlt ?? ""}
                  widths={[320, 480, 640, 960]}
                  sizes="(min-width: 1101px) 31.25vw, (min-width: 768px) 21.5rem, 100vw"
                  class="h-auto w-full"
                />
              )
            }
            {
              /* Wyjątek od zera zaokrągleń: karta odtwarzacza ma własny promień
                 wewnątrz iframe'u, więc rama musi go powtórzyć, inaczej rogi
                 świecą tłem. 152 px = kompaktowa karta pojedynczego utworu. */
              post.data.spotifyTrackId && (
                <iframe
                  style="border-radius:12px; border:0"
                  src={`https://open.spotify.com/embed/track/${post.data.spotifyTrackId}?utm_source=generator&theme=0`}
                  width="100%"
                  height="152"
                  allowfullscreen=""
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                  title={`Spotify – odtwarzacz utworu z wpisu „${post.data.title}”`}
                />
              )
            }
            </div>
          </aside>

          <div
            class:list={[
              "prose-swiss min-w-0 px-5 py-9 text-body md:px-10",
              // Dwie łamy działają tylko na krótkiej notatce. Przy przewodniku
              // łama jest wyższa niż ekran, więc czytelnik musiałby zjechać na
              // sam dół strony i wrócić na górę po drugą.
              post.data.kind === "notatka" &&
                "lg:[column-count:2] lg:[column-gap:40px]",
            ]}
          >
            <Content />
          </div>
        </div>
      </article>
    </main>

    <div
      class="grid border-t border-ink text-sm md:grid-cols-[max(calc(21.5rem_+_1px),31.25%)_minmax(0,1fr)]"
    >
      <a
        href="/blog"
        class="border-b border-hairline px-5 py-[21px] text-muted md:border-r md:border-b-0 md:px-8"
      >
        <span aria-hidden="true">←</span> Wszystkie wpisy
      </a>
      {
        next ? (
          <a
            href={`/blog/${next.id}`}
            class="flex items-center justify-between gap-4 px-5 py-[21px] md:px-8"
          >
            <span class="font-semibold">Następny: {fixHanging(next.data.title)}</span>
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <p class="px-5 py-[21px] text-muted md:px-8">
            To najstarszy wpis na blogu.
          </p>
        )
      }
    </div>

    <Footer />
  </div>
</BaseLayout>

<style>
  /* Markdown wpisu – jeden blok zamiast wtyczki typography. */
  .prose-swiss :global(p) {
    margin: 0 0 18px;
    font-size: 15.5px;
    line-height: 1.7;
  }
  .prose-swiss :global(p:last-child) {
    margin-bottom: 0;
  }
  /* Śródtytuły nie mogą się urwać na końcu kolumny. */
  .prose-swiss :global(h2),
  .prose-swiss :global(h3) {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
    break-after: avoid;
  }
  /* Odstęp nad śródtytułem dotyczy tylko przewodników – notatki śródtytułów nie
     mają. Selektor `p + h2` zamiast `:not(:first-child)` omija wojnę
     o specyficzność i nie rozdziela pary h2 + h3. */
  .prose-swiss :global(p + h2),
  .prose-swiss :global(p + h3),
  .prose-swiss :global(ul + h2),
  .prose-swiss :global(ul + h3),
  .prose-swiss :global(ol + h2),
  .prose-swiss :global(ol + h3),
  .prose-swiss :global(.table-scroll + h2),
  .prose-swiss :global(.table-scroll + h3) {
    margin-top: 30px;
  }
  /* h2 i h3 miały ten sam stopień pisma, więc podział na sekcje i pytania
     wewnątrz nich nie był widoczny – przy wywiadzie, gdzie `###` jest co drugi
     akapit, strona robiła się jednolitą listą. Sekcja dostaje większy stopień
     i własną linię. Hairline, nie ink: to linia WEWNĄTRZ pasma treści. */
  .prose-swiss :global(h2) {
    font-size: 26px;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .prose-swiss :global(p + h2),
  .prose-swiss :global(ul + h2),
  .prose-swiss :global(ol + h2) {
    margin-top: 44px;
    padding-top: 30px;
    border-top: 1px solid var(--color-hairline);
  }
  /* Preflight daje `bolder`, czyli 700 – a w całym projekcie mocniejszy tekst
     to 600 (font-bold ma tylko wordmark). Bez tego wyróżnione zdanie w treści
     jest cięższe niż tytuł wpisu. */
  .prose-swiss :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  /* Kursywa niesie termin obcy („to jest bet"). Preflight nie rusza `em`, więc
     pochylenie działałoby i bez tej reguły – ale dopiero wariant `italic`
     Archivo z astro.config.mjs daje prawdziwy krój zamiast skosu. Reguła stoi
     tu jawnie, żeby ta zależność była widoczna w jednym miejscu z resztą
     stylów treści. */
  .prose-swiss :global(em) {
    font-style: italic;
  }
  /* Listy. Preflight zeruje punktory i marginesy, więc bez tej reguły `- `
     w markdownie renderuje się jako zlepione linijki. Punktor to półpauza,
     nie kropka – ta sama kreska, którą tekst i tak stawia we wtrąceniach,
     więc lista wygląda jak ciąg dalszy akapitu, a nie jak slajd. Wcięcie
     liczone w em, żeby trzymało się stopnia pisma akapitu. */
  .prose-swiss :global(ul),
  .prose-swiss :global(ol) {
    margin: 0 0 18px;
    padding-left: 1.4em;
    font-size: 15.5px;
    line-height: 1.7;
  }
  .prose-swiss :global(ul:last-child),
  .prose-swiss :global(ol:last-child) {
    margin-bottom: 0;
  }
  .prose-swiss :global(ul) {
    list-style: none;
  }
  .prose-swiss :global(ul > li) {
    position: relative;
  }
  .prose-swiss :global(ul > li)::before {
    content: "–";
    position: absolute;
    left: -1.4em;
    color: var(--color-muted);
  }
  .prose-swiss :global(ol) {
    list-style: decimal;
  }
  .prose-swiss :global(li) {
    margin: 0 0 6px;
    /* Pozycja listy nie może pęknąć między łamami notatki. */
    break-inside: avoid;
  }
  .prose-swiss :global(li:last-child) {
    margin-bottom: 0;
  }
  /* Tabela na dane (ściąga, cennik). Preflight zeruje jej style, a łam
     ma 15,5 px, więc stopień pisma schodzi o krok, nagłówek dostaje mono
     etykietę jak reszta serwisu, a poziome linie są hairline – to linie
     WEWNĄTRZ pasma treści, nie krawędzie pasm.
     Przewija się wrapper `.table-scroll` (dokłada go wtyczka
     `src/table-scroll.ts`), a tabela pod nim ma `min-width` – bez tego pięć
     kolumn ściskało się w telefonie do nieczytelnych słupków i nic nie wystawało,
     więc nie było czego przewijać. */
  .prose-swiss :global(.table-scroll) {
    margin: 0 0 18px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose-swiss :global(.table-scroll:last-child) {
    margin-bottom: 0;
  }
  .prose-swiss :global(table) {
    width: 100%;
    min-width: 800px;
    border-collapse: collapse;
    font-size: 13.5px;
    line-height: 1.5;
    border-top: 1px solid var(--color-ink);
  }
  .prose-swiss :global(th),
  .prose-swiss :global(td) {
    padding: 8px 12px 8px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-hairline);
  }
  .prose-swiss :global(th) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .prose-swiss :global(td:first-child) {
    color: var(--color-ink);
    font-weight: 600;
    white-space: nowrap;
  }
  .prose-swiss :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
