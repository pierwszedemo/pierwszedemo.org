---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeroPhoto from "../components/HeroPhoto.astro";
import EmailLink from "../components/EmailLink.astro";
import {
  CONTACT_EMAIL,
  HOME_CITY,
  PERSON_NAME,
  SERVICES,
  SITE_NAME,
  SERVICE_PATH,
  SITE_URL,
} from "../consts";
import { breadcrumbJsonLd } from "../schema";

const canonical = new URL("/o-mnie", SITE_URL).href;
const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Start", path: "/" },
    { name: "O mnie", path: "/o-mnie" },
  ],
  canonical,
);
---

{
  /* Bez tytułu zawodowego w <title>: frazy usługowe należą do strony głównej
     i /manager-muzyczny, ta ma rankować na nazwisko – wcześniej obie strony
     miały ten sam tytuł i /o-mnie wypadła z wyników po nazwisku. */
}
<BaseLayout
  title={`O mnie – ${PERSON_NAME} | ${SITE_NAME}`}
  description={`Michał Miszczyszyn – menedżer muzyczny prowadzący Pierwsze Demo, a także przedsiębiorca, programista, autor książki i twórca Type of Web.`}
  canonicalPath="/o-mnie"
  schemaPageType="ProfilePage"
  extraJsonLd={[breadcrumb]}
>
  <div class="flex min-h-dvh flex-col">
    <Nav active="O mnie" />

    <main class="flex-1">
      <header
        class="grid border-b border-ink lg:grid-cols-[minmax(0,1fr)_clamp(15rem,31.25%,25rem)]"
      >
        <div class="px-5 pt-10 pb-9 md:px-8 md:pt-13 lg:border-r lg:border-hairline">
          <p class="label text-muted">({PERSON_NAME} – {HOME_CITY})</p>
          <h1
            class="mt-5 text-page leading-[0.95] font-semibold tracking-[-0.035em]"
          >
            O mnie.
          </h1>
        </div>
        <p
          class="text-balance flex items-end bg-ink px-5 py-7 text-[clamp(1.35rem,2.4vw,2rem)] leading-[1.15] font-semibold tracking-[-0.02em] text-white text-balance md:px-8 lg:bg-white lg:text-ink"
        >
          Kariera nie składa się z przypadkowych ruchów.
        </p>
      </header>

      <div
        class="grid border-b border-ink md:grid-cols-[clamp(15rem,31.25%,25rem)_minmax(0,1fr)]"
      >
        <HeroPhoto class="aspect-[4/5] border-b border-ink md:aspect-auto md:min-h-[38rem] md:border-r md:border-b-0" />

        <div class="flex flex-col">
          <section
            class="grid flex-1 border-b border-hairline lg:grid-cols-[minmax(10rem,0.38fr)_minmax(0,1fr)]"
          >
            <h2 class="label px-5 pt-7 text-muted md:px-8 lg:border-r lg:border-hairline lg:py-10">
              Kim jestem
            </h2>
            <div
              class="flex max-w-[62ch] flex-col gap-5 px-5 py-7 text-[clamp(1.05rem,1.6vw,1.25rem)] leading-[1.6] text-body md:px-8 lg:px-10 lg:py-10"
            >
              <p>
                <strong>
                Michał Miszczyszyn to manager artystów i przedsiębiorca
                działający na styku muzyki i technologii.
                </strong>
              </p>
              <p>
                Od blisko 20 lat kojarzony przede wszystkim z branżą
                technologiczną – jako product engineer specjalizujący się w e‑commerce, twórca <a
                  href="https://pl.typeofweb.com"
                  class="underline decoration-1 underline-offset-4"
                >Type of Web</a>, edukator oraz autor książki „TypeScript na
                poważnie”.
              </p>
              <p>
                Jest współzałożycielem, a dawniej też CTO i członkiem zarządu, <a
                  href="https://yournextstore.com"
                  class="underline decoration-1 underline-offset-4"
                >Your Next Store</a> – amerykańskiego startupu rozwijającego platformę
                e-commerce. Ma doświadczenie w zarządzaniu
                zespołami ludzi, tworzeniu kursów online oraz organizowaniu
                międzynarodowych konferencji i meetupów.
              </p>
              <p>
                Równolegle działa w branży muzycznej. Pod marką Pierwsze Demo
                zajmuje się managementem, bookingiem i wsparciem
                wydawniczym artystów alternatywnych – od pierwszego demo do festiwalowych scen.
              </p>
              <p>
                W wolnym czasie prowadzi podcast <a
                  class="underline decoration-1 underline-offset-4"
                  href="https://www.youtube.com/c/%C5%9AniadaniezProgramowaniem/videos"
                ><em>Drama – Devs, Release, Afery, Modele AI</em></a> gdzie dyskutuje na tematy sztucznej
                inteligencji i zmian zachodzących w branży technologicznej.
              </p>
            </div>
          </section>

          <section class="grid lg:grid-cols-[minmax(10rem,0.38fr)_minmax(0,1fr)]">
            <h2 class="label px-5 pt-7 text-muted md:px-8 lg:border-r lg:border-hairline lg:py-9">
              Zakres
            </h2>
            <ul class="divide-y divide-hairline px-5 py-3 md:px-8 lg:px-10">
              {
                SERVICES.map((service) => (
                  <li class="flex items-baseline justify-between gap-4 py-4">
                    <a
                      href={`${SERVICE_PATH}#${service.id}`}
                      class="text-row font-semibold underline decoration-1 underline-offset-4"
                    >
                      {service.label}
                    </a>
                    <span class="label text-muted">({service.no})</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </div>

      <section
        class="flex flex-col gap-5 px-5 py-8 md:flex-row md:items-center md:justify-between md:px-8"
      >
        <div>
          <h2 class="label text-muted">Kontakt</h2>
          <p class="mt-3 text-xl font-semibold">Masz projekt, o którym warto porozmawiać?</p>
        </div>
        {/* Adres dosłownie, nie „Napisz do mnie": nawigacja nie ma już komórki
            Kontakt, więc to tutaj ktoś szuka adresu. Wersaliki robi CSS –
            w DOM-ie i po skopiowaniu adres zostaje małymi literami. */}
        <EmailLink
          class="label self-start border border-ink px-5 py-4 transition-colors hover:bg-ink hover:text-white md:self-auto"
        >
          {CONTACT_EMAIL} <span aria-hidden="true">↗</span>
        </EmailLink>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
