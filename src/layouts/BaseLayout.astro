---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import ConsentManager from "../components/ConsentManager.astro";
import {
	CF_BEACON_TOKEN,
	CONTACT_EMAIL,
	FOUNDATION,
	FOUNDATION_PATH,
	GA_ID,
	GOALS,
	HOME_CITY,
	INSTAGRAM_URL,
	LAST_CONTENT_UPDATE,
	ORGANIZATION_ID,
	PERSON_ID,
	PERSON_PROFILES,
	SITE_DESCRIPTION,
	SITE_NAME,
	SITE_URL,
	WEBSITE_ID,
} from "../consts";
import { FOUNDER_PHOTOS } from "../photos";
import { isoDateTime } from "../schema";
import { FOUNDERS } from "../strony";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	robots?: string;
	ogType?: string;
	/** Ścieżka do karty OG 1200×630. Wpisy podstawiają własną z /og/<slug>.png. */
	ogImage?: string;
	/** Typ węzła strony w @graph – strona główna jest profilem fundacji. */
	schemaPageType?: "WebPage" | "ProfilePage" | "CollectionPage";
	/** Dodatkowe węzły dopinane do schema.org @graph (np. BlogPosting). */
	extraJsonLd?: Record<string, unknown>[];
	/** Data (YYYY-MM-DD wystarczy) – schema.org dateModified tej strony.
	 * Na pełne ISO 8601 rozwija ją `isoDateTime()` niżej. */
	dateModified?: string;
}

const {
	title,
	description = SITE_DESCRIPTION,
	canonicalPath = Astro.url.pathname,
	robots = "index, follow, max-image-preview:large",
	ogType = "website",
	ogImage = "/og.png",
	schemaPageType = "WebPage",
	extraJsonLd = [],
	dateModified = LAST_CONTENT_UPDATE,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(canonicalPath, site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Fundacja jest podmiotem strony: `NGO` to podtyp Organization, który Google
// rozumie, a `foundingDate`, `taxID` i `legalName` to te same dane, co
// w stopce i w polityce prywatności. Numery z KRS trafiają tu dopiero, gdy
// są – puste pola są pomijane, bo pusty `taxID` to błąd walidacji.
const organizationJsonLd = {
	"@type": "NGO",
	"@id": ORGANIZATION_ID,
	name: SITE_NAME,
	legalName: FOUNDATION.name,
	alternateName: "Pierwsze Demo",
	url: site.href,
	description: SITE_DESCRIPTION,
	email: `mailto:${CONTACT_EMAIL}`,
	logo: new URL("/web-app-manifest-512x512.png", site).href,
	...(FOUNDATION.nip ? { taxID: FOUNDATION.nip } : {}),
	...(FOUNDATION.krs
		? {
				identifier: {
					"@type": "PropertyValue",
					propertyID: "KRS",
					value: FOUNDATION.krs,
				},
			}
		: {}),
	nonprofitStatus: "https://schema.org/NonprofitType",
	founder: FOUNDERS.map((person) => ({ "@id": person.schemaId })),
	member: FOUNDERS.map((person) => ({
		"@type": "OrganizationRole",
		member: { "@id": person.schemaId },
		roleName: person.role,
	})),
	knowsAbout: GOALS,
	areaServed: { "@type": "Country", name: "Polska" },
	address: {
		"@type": "PostalAddress",
		streetAddress: FOUNDATION.street,
		postalCode: FOUNDATION.postalCode,
		addressLocality: FOUNDATION.city,
		addressCountry: "PL",
	},
	sameAs: [INSTAGRAM_URL],
};

// Dwie osoby, dwa węzły Person – obie są członkami Zarządu, więc obie
// dostają `memberOf` i `worksFor`; profile zewnętrzne ma na razie tylko
// Michał (`PERSON_PROFILES`), Ola – własną stronę.
const peopleJsonLd = FOUNDERS.map((person) => ({
	"@type": "Person",
	"@id": person.schemaId,
	name: person.fullName,
	...(person.name !== person.fullName ? { alternateName: person.name } : {}),
	url: `${new URL(FOUNDATION_PATH, site).href}#${person.id}`,
	jobTitle: `${person.role}, ${person.jobTitle}`,
	email: `mailto:${person.email}`,
	description: person.bio[0],
	image: new URL(FOUNDER_PHOTOS[person.id].src.src, site).href,
	homeLocation: {
		"@type": "Place",
		name: HOME_CITY,
		address: {
			"@type": "PostalAddress",
			addressLocality: HOME_CITY,
			addressCountry: "PL",
		},
	},
	worksFor: { "@id": ORGANIZATION_ID },
	memberOf: { "@id": ORGANIZATION_ID },
	sameAs: person.schemaId === PERSON_ID ? PERSON_PROFILES.map((profile) => profile.href) : [person.href],
}));

const websiteJsonLd = {
	"@type": "WebSite",
	"@id": WEBSITE_ID,
	url: site.href,
	name: SITE_NAME,
	description: SITE_DESCRIPTION,
	inLanguage: "pl",
	publisher: { "@id": ORGANIZATION_ID },
	about: { "@id": ORGANIZATION_ID },
};

// Strony z noindex (404) nie dostają własnego węzła – nie ma czego indeksować.
const pageJsonLd = robots.includes("noindex")
	? null
	: {
			"@type": schemaPageType,
			"@id": canonical,
			url: canonical,
			name: title,
			description,
			inLanguage: "pl",
			isPartOf: { "@id": WEBSITE_ID },
			primaryImageOfPage: ogImageUrl,
			dateModified: isoDateTime(dateModified),
			// ProfilePage opisuje fundację wprost; pozostałe strony tylko jej dotyczą.
			...(schemaPageType === "ProfilePage"
				? { mainEntity: { "@id": ORGANIZATION_ID } }
				: { about: { "@id": ORGANIZATION_ID } }),
		};

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		organizationJsonLd,
		...peopleJsonLd,
		websiteJsonLd,
		...(pageJsonLd ? [pageJsonLd] : []),
		...extraJsonLd,
	],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbfaf7" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      `sizes` na .ico nie jest ozdobą: bez niego crawler nie ma powodu sięgać
      głębiej niż pierwszy wpis w katalogu pliku. Google właśnie tak wziął
      wariant 16×16 i rozmazał go na 48 px w wynikach wyszukiwania.
    -->
    <link
      rel="icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48 64x64 96x96"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} – wiedza i aktualności`}
      href="/rss.xml"
    />

    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-ibm-plex-mono" preload />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />

    <!-- Umami – analityka bez cookies (nie wymaga zgody). Skrypt sam podpina się
         pod history.pushState, więc liczy też nawigacje przez View Transitions. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="3ff6a02b-368d-4b2b-b697-25cab2f8a077"></script>

    {
      /* Cloudflare Web Analytics – też bez cookies. `spa: true`, bo nawigacje
         ClientRoutera to pushState, nie pełne przeładowania strony. */
      CF_BEACON_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN, spa: true })}
        />
      )
    }

    {
      /* Google Consent Mode v2 – domyślne odmowy MUSZĄ pojechać przed gtag.js.
         Tryb advanced: loader ładuje się zawsze, ale przy `denied` nie zapisuje
         cookies, tylko wysyła bezcookie'owe pingi. Podniesienie zgód robi
         src/scripts/consent.ts po decyzji użytkownika. */
    }
    {
      GA_ID && (
        <>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied",
              functionality_storage: "denied",
              personalization_storage: "denied",
              security_storage: "granted",
              wait_for_update: 500,
            });
            gtag("set", "ads_data_redaction", true);
            gtag("set", "url_passthrough", true);
          </script>

          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script is:inline define:vars={{ GA_ID }}>
            gtag("js", new Date());
            // send_page_view:false – page_view wysyłamy ręcznie na
            // astro:page-load, żeby liczyć też nawigacje przez View Transitions.
            gtag("config", GA_ID, { send_page_view: false });
            document.addEventListener("astro:page-load", () => {
              gtag("event", "page_view", {
                page_path: location.pathname + location.search,
                page_location: location.href,
                page_title: document.title,
              });
            });
          </script>
        </>
      )
    }
  </head>

  <body
    class="min-h-dvh bg-paper font-sans text-ink antialiased [text-rendering:optimizeLegibility]"
  >
    {/* WCAG 2.4.1: pierwszy cel tabulatora, widoczny dopiero z fokusem.
        Każdy <main> w serwisie ma id="tresc". */}
    <a
      href="#tresc"
      class="label sr-only z-50 bg-ink text-white focus:not-sr-only focus:fixed focus:px-5 focus:py-4 focus:top-0 focus:left-0 focus-visible:outline-white focus-visible:-outline-offset-4"
    >
      Przejdź do treści
    </a>
    <slot />
    <ConsentManager />
  </body>
</html>
