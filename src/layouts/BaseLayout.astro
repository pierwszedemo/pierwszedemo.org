---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import michal from "../assets/michal.jpg";
import {
  CONTACT_EMAIL,
  HOME_CITY,
  LAST_CONTENT_UPDATE,
  PERSON_ID,
  SERVICES,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
  SOCIALS,
  WEBSITE_ID,
} from "../consts";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  ogType?: string;
  /** Ścieżka do karty OG 1200×630. Wpisy podstawiają własną z /og/<slug>.png. */
  ogImage?: string;
  /** Typ węzła strony w @graph — strona główna jest profilem osoby. */
  schemaPageType?: "WebPage" | "ProfilePage" | "CollectionPage";
  /** Dodatkowe węzły dopinane do schema.org @graph (np. BlogPosting). */
  extraJsonLd?: Record<string, unknown>[];
  /** ISO date — schema.org dateModified tej strony. */
  dateModified?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  robots = "index, follow, max-image-preview:large",
  ogType = "website",
  ogImage = "/og.png",
  schemaPageType = "WebPage",
  extraJsonLd = [],
  dateModified = LAST_CONTENT_UPDATE,
} = Astro.props;

const site = Astro.site ?? new URL("https://miszczyszyn.com");
const canonical = new URL(canonicalPath, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const photoUrl = new URL(michal.src, site).href;

const personJsonLd = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: SITE_NAME,
  url: site.href,
  jobTitle: SITE_TAGLINE,
  description: SITE_DESCRIPTION,
  email: `mailto:${CONTACT_EMAIL}`,
  image: photoUrl,
  mainEntityOfPage: site.href,
  // Usługi z pasma hero jako katalog — te trzy pozycje to jedyne, co strona
  // faktycznie oferuje, więc encja nie obiecuje niczego ponad treść.
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Usługi",
    itemListElement: SERVICES.map((service) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: service.label },
    })),
  },
  knowsLanguage: ["pl", "en"],
  knowsAbout: [
    "management artystów",
    "wydawnictwa muzyczne",
    "booking koncertowy",
    "promocja muzyki",
  ],
  hasOccupation: { "@type": "Occupation", name: SITE_TAGLINE },
  homeLocation: {
    "@type": "Place",
    name: HOME_CITY,
    address: {
      "@type": "PostalAddress",
      addressLocality: HOME_CITY,
      addressCountry: "PL",
    },
  },
  sameAs: SOCIALS.map((social) => social.href),
};
const websiteJsonLd = {
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  url: site.href,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  inLanguage: "pl",
  publisher: { "@id": PERSON_ID },
  about: { "@id": PERSON_ID },
};
// Strony z noindex (404) nie dostają własnego węzła — nie ma czego indeksować.
const pageJsonLd = robots.includes("noindex")
  ? null
  : {
      "@type": schemaPageType,
      "@id": canonical,
      url: canonical,
      name: title,
      description,
      inLanguage: "pl",
      isPartOf: { "@id": WEBSITE_ID },
      primaryImageOfPage: ogImageUrl,
      dateModified,
      // ProfilePage opisuje osobę wprost; pozostałe strony tylko jej dotyczą.
      ...(schemaPageType === "ProfilePage"
        ? { mainEntity: { "@id": PERSON_ID } }
        : { about: { "@id": PERSON_ID } }),
    };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    personJsonLd,
    websiteJsonLd,
    ...(pageJsonLd ? [pageJsonLd] : []),
    ...extraJsonLd,
  ],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — blog`}
      href="/rss.xml"
    />

    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-ibm-plex-mono" preload />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />
  </head>

  <body
    class="min-h-dvh bg-white font-sans text-ink antialiased [text-rendering:optimizeLegibility]"
  >
    <slot />
  </body>
</html>
