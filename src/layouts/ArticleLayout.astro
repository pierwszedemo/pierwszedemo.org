---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { type Article, hasBodyImage, isoDate, type News, plDate, readingMinutes } from "../collections";
import Footer from "../components/Footer.astro";
import Middot from "../components/Middot.astro";
import Nav from "../components/Nav.astro";
import { NAV, ORGANIZATION_ID, SITE_URL, WEBSITE_ID } from "../consts";
import { breadcrumbJsonLd, isoDateTime, pageTitle, wordCount } from "../schema";
import { authorJsonLd } from "../strony";
import { fixHanging } from "../typography";
import BaseLayout from "./BaseLayout.astro";

/**
 * Wspólny szkielet strony wpisu dla bazy wiedzy i aktualności: pigułki
 * z działem i kategorią nad tytułem, karta „W skrócie” obok treści i dwie
 * karty prev/next pod nią. Różnią się tylko tym, co stoi w pigułce
 * (kategoria albo rodzaj aktualności), czy treść idzie w dwóch łamach
 * i dokąd prowadzą karty – to przychodzi w propsach.
 */
interface Props {
	entry: Article | News;
	/** Dział, do którego należy wpis – nazwa i ścieżka listy. */
	section: { label: (typeof NAV)[number]["label"]; href: string };
	/** Pigułka obok działu: kategoria albo rodzaj wpisu. */
	meta: string;
	/** Etykieta pod kategorią na liście i w JSON-LD (`notatka · 2 min`). */
	kindLabel?: string;
	/** Dwie łamy działają tylko na krótkim tekście – patrz komentarz przy treści. */
	twoColumns: boolean;
	next?: { href: string; title: string };
	/** Słowa kluczowe do JSON-LD; kategoria i fraza główna, jeśli są. */
	keywords: string[];
	/** Tekst paska prev/next, gdy wpis jest najstarszy w dziale. */
	oldestLabel: string;
}

const { entry, section, meta, twoColumns, next, keywords, oldestLabel } = Astro.props;
const { Content } = await render(entry);
const path = `${section.href}/${entry.id}`;
const canonical = new URL(path, SITE_URL).href;
// Przewodniki starzeją się na liczbach, więc po rewizji faktów liczy się data
// aktualizacji – ale data publikacji zostaje, bo porządkuje listę wpisów.
const modified = isoDate(entry.data.updated ?? entry.data.date);
const ogImage = `/og/${entry.id}.png`;

// Autorem jest człowiek (podpis pod wpisem), wydawcą – fundacja. Google
// czyta `author` jako sygnał E-E-A-T i nie lubi, gdy autorem jest organizacja.
const articleJsonLd = {
	"@type": "BlogPosting",
	"@id": `${canonical}#post`,
	headline: entry.data.title,
	description: entry.data.lead,
	url: canonical,
	articleSection: meta,
	datePublished: isoDateTime(entry.data.date),
	dateModified: isoDateTime(modified),
	inLanguage: "pl",
	author: authorJsonLd(entry.data.authors),
	publisher: { "@id": ORGANIZATION_ID },
	isPartOf: { "@id": WEBSITE_ID },
	mainEntityOfPage: { "@id": canonical },
	image: new URL(ogImage, SITE_URL).href,
	wordCount: wordCount(entry.body ?? ""),
	// ISO 8601 – ta sama liczba, którą widać w pasku metadanych wpisu.
	timeRequired: `PT${readingMinutes(entry)}M`,
	keywords,
};

// Szkic ma adres, żeby dało się go komuś wysłać przed publikacją, ale to nie
// jest strona serwisu: noindex, bez danych strukturalnych (BaseLayout i tak
// pomija węzeł strony przy noindex) i z paskiem, że to podgląd.
const isDraft = entry.data.draft;

const breadcrumb = breadcrumbJsonLd(
	[
		{ name: "Start", path: "/" },
		{ name: section.label, path: section.href },
		{ name: entry.data.title, path },
	],
	canonical,
);
---

<BaseLayout
  title={pageTitle(entry.data.title)}
  description={entry.data.lead}
  canonicalPath={path}
  ogType="article"
  ogImage={ogImage}
  dateModified={modified}
  extraJsonLd={isDraft ? [] : [articleJsonLd, breadcrumb]}
  robots={isDraft ? "noindex, nofollow" : undefined}
>
  {
    isDraft && (
      <div role="note" class="bg-preview text-ink">
        <p class="wrap py-4 text-[15px]">
          <strong class="font-semibold">To jest podgląd.</strong> Szkic – nie ma go na stronie ani
          w wyszukiwarkach, widzi go tylko ktoś z tym linkiem.
        </p>
      </div>
    )
  }
  <Nav active={section.label} />

  <main id="tresc">
    <article>
      <header class="wrap flex flex-col gap-7 pt-6 pb-12 md:pt-10 md:pb-16">
        {/* Dział w pigułce to widoczny okruszek – ten sam, co BreadcrumbList
            w JSON-LD, tylko bez „Start”, który i tak jest pod logotypem. */}
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[15px]">
          <a
            href={section.href}
            class="rounded-full border border-hairline bg-white px-3.5 py-1.5 font-semibold transition-colors hover:border-ink"
          >
            {section.label}
          </a>
          <span class="rounded-full bg-lime px-3.5 py-1.5 font-semibold">{meta}</span>
          <span class="text-muted">
            <time datetime={isoDate(entry.data.date)}>{plDate(entry.data.date)}</time><Middot />{readingMinutes(entry)} min
            czytania
          </span>
        </p>
        <h1
          class="max-w-[20ch] font-serif text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95] tracking-[-0.02em] text-balance"
        >
          {/* Niełamliwe spacje tylko w tekście widocznym na stronie – w meta,
              JSON-LD, RSS-ie i llms.txt to dane dla maszyn, nie typografia. */}
          {fixHanging(entry.data.title)}
        </h1>
      </header>

      {
        /* Wyimek jako osobna karta, nie znacznik w treści: korpus wpisu
           dopuszcza tylko akapity, nagłówki, linki, strong i em, a karta
           wpada w oko komuś, kto przelatuje stronę wzrokiem – czego samo
           pogrubienie nie robi. figure + blockquote, bo to cytat z rozmowy –
           czytnik ogłasza go jako cytat, a autor w figcaption jest z nim
           powiązany. */
        entry.data.pullquote && (
          <figure class="wrap pb-12 md:pb-16">
            <div class="rounded-[28px] bg-lime p-8 md:p-12">
              <blockquote>
                <p class="max-w-[30ch] font-serif text-[clamp(1.75rem,3.2vw,2.75rem)] leading-[1.1] text-pretty">
                  {fixHanging(`„${entry.data.pullquote}”`)}
                </p>
              </blockquote>
              {entry.data.pullquoteAuthor && (
                <figcaption class="label mt-6">{entry.data.pullquoteAuthor}</figcaption>
              )}
            </div>
          </figure>
        )
      }

      {/* Jawne `minmax(0, 1fr)` w obu układach i `min-w-0` na treści: niejawna
          kolumna `auto` rośnie do min-content, a tabela 800 px wypychała
          całą stronę poza ekran zamiast pozwolić wrapperowi ją przewinąć.
          Kolumna „W skrócie” ma co najmniej 17,5 rem – odtwarzacz Spotify
          potrzebuje 280 px. */}
      <div
        class="wrap grid grid-cols-[minmax(0,1fr)] gap-x-10 gap-y-10 pb-16 md:grid-cols-[17.5rem_minmax(0,1fr)] md:pb-24 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-x-16"
      >
        <aside>
          {/* Sticky tylko od md – poniżej kolumny stoją jedna pod drugą.
              Pod przyklejoną nawigacją, z odstępem – `--nav-clearance`. */}
          <div class="flex flex-col gap-5 md:sticky md:top-[calc(var(--nav-clearance)+1.5rem)]">
            <div class="flex flex-col gap-4 rounded-[28px] border border-hairline bg-white p-6">
              <h2 class="label text-muted">W skrócie</h2>
              <p class="text-xl leading-[1.45] text-ink">{fixHanging(entry.data.lead)}</p>
              <slot name="aside" />
            </div>
            {
              /* Grafika wpisu siedzi pod leadem, nie w treści: kolumna ma stałą
                 szerokość i sticky, a korpus w dwóch łamach rozerwałby obrazek
                 na granicy kolumny. */
              entry.data.image && (
                <Image
                  src={entry.data.image}
                  alt={entry.data.imageAlt ?? ""}
                  widths={[320, 480, 640, 960]}
                  sizes="(min-width: 1024px) 20rem, (min-width: 768px) 17.5rem, 100vw"
                  class="h-auto w-full rounded-[20px]"
                />
              )
            }
            {
              /* Karta odtwarzacza ma własny promień wewnątrz iframe'u, więc
                 rama musi go powtórzyć, inaczej rogi świecą tłem. 152 px =
                 kompaktowa karta pojedynczego utworu. */
              entry.data.spotifyTrackId && (
                <iframe
                  style="border-radius:12px; border:0"
                  src={`https://open.spotify.com/embed/track/${entry.data.spotifyTrackId}?utm_source=generator&theme=0`}
                  width="100%"
                  height="152"
                  allowfullscreen=""
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                  title={`Spotify – odtwarzacz utworu z wpisu „${entry.data.title}”`}
                />
              )
            }
          </div>
        </aside>

        <div
          class:list={[
            "prose-swiss min-w-0 text-body",
            // Dwie łamy działają tylko na krótkiej notatce. Przy przewodniku
            // łama jest wyższa niż ekran, więc czytelnik musiałby zjechać na
            // sam dół strony i wrócić na górę po drugą.
            // Obrazek w treści też wyłącza łamy (patrz hasBodyImage).
            twoColumns && !hasBodyImage(entry) && "lg:[column-count:2] lg:[column-gap:40px]",
          ]}
        >
          <Content />
          <slot name="after" />
        </div>
      </div>
    </article>
  </main>

  <nav aria-label="Inne wpisy" class="wrap grid gap-5 pb-16 md:grid-cols-2 md:pb-24">
    <a
      href={section.href}
      class="group flex flex-col justify-between gap-6 rounded-[28px] border border-hairline bg-white p-8 transition-colors hover:border-ink"
    >
      <span class="label text-muted">{section.label}</span>
      <span class="font-serif text-row leading-[1.05]">
        <span aria-hidden="true">←</span> Wszystkie wpisy
      </span>
    </a>
    {
      next ? (
        <a
          href={next.href}
          class="group flex flex-col justify-between gap-6 rounded-[28px] bg-ink p-8 text-white transition-colors hover:bg-blue"
        >
          <span class="label text-fog">Następny</span>
          <span class="font-serif text-row leading-[1.05] text-balance">
            {fixHanging(next.title)} <span aria-hidden="true">→</span>
          </span>
        </a>
      ) : (
        <p class="flex items-end rounded-[28px] border border-dashed border-muted p-8 text-muted">
          {oldestLabel}
        </p>
      )
    }
  </nav>
  <Footer />
</BaseLayout>
