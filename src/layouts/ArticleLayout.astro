---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { hasBodyImage, isoDate, readingMinutes, type Article, type News } from "../collections";
import { breadcrumbJsonLd, isoDateTime, wordCount } from "../schema";
import { fixHanging } from "../typography";
import {
  NAV,
  ORGANIZATION_ID,
  PERSON_ID,
  SITE_NAME,
  SITE_URL,
  WEBSITE_ID,
} from "../consts";

/**
 * Wspólny szkielet strony wpisu dla bazy wiedzy i aktualności: pasek
 * metadanych 5 / 6 / 5, wcięty tytuł, kolumna „W skrócie” i treść. Różnią
 * się tylko tym, co stoi w środkowej komórce paska (kategoria albo rodzaj
 * aktualności), czy treść idzie w dwóch łamach i dokąd prowadzi pasek
 * prev/next – to przychodzi w propsach.
 */
interface Props {
  entry: Article | News;
  /** Dział, do którego należy wpis – nazwa i ścieżka listy. */
  section: { label: (typeof NAV)[number]["label"]; href: string };
  /** Środkowa komórka paska metadanych: kategoria albo rodzaj wpisu. */
  meta: string;
  /** Etykieta pod kategorią na liście i w JSON-LD (`notatka · 2 min`). */
  kindLabel?: string;
  /** Dwie łamy działają tylko na krótkim tekście – patrz komentarz przy treści. */
  twoColumns: boolean;
  next?: { href: string; title: string };
  /** Słowa kluczowe do JSON-LD; kategoria i fraza główna, jeśli są. */
  keywords: string[];
  /** Tekst paska prev/next, gdy wpis jest najstarszy w dziale. */
  oldestLabel: string;
}

const { entry, section, meta, twoColumns, next, keywords, oldestLabel } =
  Astro.props;
const { Content } = await render(entry);
const path = `${section.href}/${entry.id}`;
const canonical = new URL(path, SITE_URL).href;
// Przewodniki starzeją się na liczbach, więc po rewizji faktów liczy się data
// aktualizacji – ale data publikacji zostaje, bo porządkuje listę wpisów.
const modified = isoDate(entry.data.updated ?? entry.data.date);
const ogImage = `/og/${entry.id}.png`;

// Autorem jest człowiek (podpis pod wpisem), wydawcą – fundacja. Google
// czyta `author` jako sygnał E-E-A-T i nie lubi, gdy autorem jest organizacja.
const articleJsonLd = {
  "@type": "BlogPosting",
  "@id": `${canonical}#post`,
  headline: entry.data.title,
  description: entry.data.lead,
  url: canonical,
  articleSection: meta,
  datePublished: isoDateTime(entry.data.date),
  dateModified: isoDateTime(modified),
  inLanguage: "pl",
  author: { "@id": PERSON_ID },
  publisher: { "@id": ORGANIZATION_ID },
  isPartOf: { "@id": WEBSITE_ID },
  mainEntityOfPage: { "@id": canonical },
  image: new URL(ogImage, SITE_URL).href,
  wordCount: wordCount(entry.body ?? ""),
  // ISO 8601 – ta sama liczba, którą widać w pasku metadanych wpisu.
  timeRequired: `PT${readingMinutes(entry)}M`,
  keywords,
};

const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Start", path: "/" },
    { name: section.label, path: section.href },
    { name: entry.data.title, path },
  ],
  canonical,
);
---

<BaseLayout
  title={`${entry.data.title} – ${SITE_NAME}`}
  description={entry.data.lead}
  canonicalPath={path}
  ogType="article"
  ogImage={ogImage}
  dateModified={modified}
  extraJsonLd={[articleJsonLd, breadcrumb]}
>
  <div class="flex min-h-dvh flex-col">
    <Nav active={section.label} />

    <main id="tresc" class="flex flex-1 flex-col">
      {/* Kolumna „W skrócie" = kolumna boczna siatki, ale nie węższa niż
            21.5 rem: odtwarzacz Spotify potrzebuje 280 px, a padding kolumny
            zabiera 2 × 32 px, a border-r jeszcze 1 px. Od ~1100 px wygrywa siatka. */}
      <article class="flex flex-1 flex-col md:[--post-aside:max(calc(21.5rem_+_1px),var(--aside))]">
        <!-- Pasek metadanych: data / kategoria / czas czytania. Tory 5 / 6 / 5
             z 16 modułów – te same linie co w nawigacji. -->
        <div
          class="label grid grid-cols-2 border-b border-ink text-muted md:grid-cols-[var(--aside)_minmax(0,1fr)_var(--aside)]"
        >
          <div
            class="border-r border-b border-hairline px-5 py-[18px] md:border-b-0 md:px-8"
          >
            <time datetime={isoDate(entry.data.date)}>
              {isoDate(entry.data.date)}
            </time>
          </div>
          <div
            class="border-b border-hairline px-5 py-[18px] md:border-r md:border-b-0 md:px-8"
          >
            {meta}
          </div>
          <div class="col-span-2 px-5 py-[18px] md:col-span-1 md:px-8">
            {readingMinutes(entry)} min czyt.
          </div>
        </div>

        <!-- Wcięcie = szerokość kolumny „W skrócie" + 32 px, żeby tytuł
             zaczynał się w osi tekstu wpisu. -->
        <header
          class="border-b border-ink px-5 py-10 md:px-8 md:pl-[calc(var(--post-aside)_+_2rem)]"
        >
          <h1
            class="max-w-[18ch] text-post leading-[1.02] font-semibold tracking-[-0.03em] text-balance"
          >
            {/* Niełamliwe spacje tylko w tekście widocznym na stronie – w meta,
                JSON-LD, RSS-ie i llms.txt to dane dla maszyn, nie typografia. */}
            {fixHanging(entry.data.title)}
          </h1>
        </header>

        {
          /* Wyimek jako osobne pasmo, nie znacznik w treści: korpus wpisu
             dopuszcza tylko akapity, nagłówki, linki, strong i em, a pasmo
             wpada w oko komuś, kto przelatuje stronę wzrokiem – czego samo
             pogrubienie nie robi, bo `strong` to tu tylko waga 600.
             Wcięcie jak w nagłówku, żeby cytat stał w osi tekstu wpisu.
             figure + blockquote, nie <aside>: complementary w <main> to
             osobny region dla czytnika, a to cytat z rozmowy. */
          entry.data.pullquote && (
            <figure class="border-b border-ink px-5 py-10 md:px-8 md:pl-[calc(var(--post-aside)_+_2rem)]">
              <blockquote>
                <p class="text-row leading-[1.3] font-medium tracking-[-0.01em] text-pretty text-ink">
                  {fixHanging(`„${entry.data.pullquote}”`)}
                </p>
              </blockquote>
              {entry.data.pullquoteAuthor && (
                <figcaption class="label mt-[18px] text-muted">
                  {entry.data.pullquoteAuthor}
                </figcaption>
              )}
            </figure>
          )
        }

        {/* Poniżej md siatka nie ma zadeklarowanych kolumn, a niejawna kolumna
            `auto` rośnie do min-content treści – przy tabeli 800 px wypychała
            całą stronę poza ekran zamiast pozwolić wrapperowi ją przewinąć.
            Stąd jawne `minmax(0, 1fr)` w obu układach i `min-w-0` na komórce. */}
        <div
          class="grid flex-1 grid-cols-[minmax(0,1fr)] md:grid-cols-[var(--post-aside)_minmax(0,1fr)]"
        >
          {/* div, nie <aside>: lead to streszczenie tego wpisu, nie treść poboczna,
              a landmark complementary zagnieżdżony w <main> czytnik ekranu
              ogłasza jako osobny region strony. */}
          <div
            class="border-b border-hairline px-5 py-9 md:border-r md:border-b-0 md:px-8"
          >
            {/* Sticky na wewnętrznym divie, nie na kolumnie: kolumna musi zostać
                pełnej wysokości, żeby border-r biegł przez całe pasmo treści.
                Tylko od md – poniżej kolumny są ułożone jedna pod drugą.
                top-9 = pionowy padding aside, żeby przyklejona treść stawała
                dokładnie tam, gdzie stoi przed scrollem. */}
            <div class="flex flex-col gap-[18px] md:sticky md:top-9">
              <h2 class="label text-muted">W skrócie</h2>
              <p class="text-xl leading-[1.5] font-medium text-body">
                {fixHanging(entry.data.lead)}
              </p>
              {
                /* Grafika wpisu siedzi pod leadem, nie w treści: kolumna „W skrócie"
                   ma już stałą szerokość i sticky, a korpus w dwóch łamach
                   rozerwałby obrazek na granicy kolumny. sizes odpowiada
                   szerokościom aside: 5 modułów siatki, poniżej ~1100 px 21.5 rem,
                   pełna szerokość poniżej md. */
                entry.data.image && (
                  <Image
                    src={entry.data.image}
                    alt={entry.data.imageAlt ?? ""}
                    widths={[320, 480, 640, 960]}
                    sizes="(min-width: 1101px) 31.25vw, (min-width: 768px) 21.5rem, 100vw"
                    class="h-auto w-full"
                  />
                )
              }
              {
                /* Wyjątek od zera zaokrągleń: karta odtwarzacza ma własny promień
                   wewnątrz iframe'u, więc rama musi go powtórzyć, inaczej rogi
                   świecą tłem. 152 px = kompaktowa karta pojedynczego utworu. */
                entry.data.spotifyTrackId && (
                  <iframe
                    style="border-radius:12px; border:0"
                    src={`https://open.spotify.com/embed/track/${entry.data.spotifyTrackId}?utm_source=generator&theme=0`}
                    width="100%"
                    height="152"
                    allowfullscreen=""
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                    loading="lazy"
                    title={`Spotify – odtwarzacz utworu z wpisu „${entry.data.title}”`}
                  />
                )
              }
              <slot name="aside" />
            </div>
          </div>

          <div
            class:list={[
              "prose-swiss min-w-0 px-5 py-9 text-body md:px-10",
              // Dwie łamy działają tylko na krótkiej notatce. Przy przewodniku
              // łama jest wyższa niż ekran, więc czytelnik musiałby zjechać na
              // sam dół strony i wrócić na górę po drugą.
              // Obrazek w treści też wyłącza łamy (patrz hasBodyImage).
              twoColumns && !hasBodyImage(entry) && "lg:[column-count:2] lg:[column-gap:40px]",
            ]}
          >
            <Content />
            <slot name="after" />
          </div>
        </div>
      </article>
    </main>

    <nav
      aria-label="Inne wpisy"
      class="grid border-t border-ink text-sm md:grid-cols-[max(calc(21.5rem_+_1px),31.25%)_minmax(0,1fr)]"
    >
      <a
        href={section.href}
        class="border-b border-hairline px-5 py-[21px] text-muted md:border-r md:border-b-0 md:px-8"
      >
        <span aria-hidden="true">←</span> {section.label}: wszystkie wpisy
      </a>
      {
        next ? (
          <a
            href={next.href}
            class="flex items-center justify-between gap-4 px-5 py-[21px] md:px-8"
          >
            <span class="font-semibold">Następny: {fixHanging(next.title)}</span>
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <p class="px-5 py-[21px] text-muted md:px-8">{oldestLabel}</p>
        )
      }
    </nav>
    <Footer />
  </div>
</BaseLayout>
