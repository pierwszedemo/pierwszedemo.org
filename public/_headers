# Panel Tiny to aplikacja dla redakcji, nie treść – poza indeksem. Nagłówek,
# nie Disallow w robots.txt: zablokowany crawler nie zobaczy noindex i może
# zaindeksować sam adres.
/admin/*
  X-Robots-Tag: noindex, nofollow

/admin
  X-Robots-Tag: noindex, nofollow

# Po pierwszej wizycie przez HTTPS przeglądarka nie zapyta już o http://.
# Bez includeSubDomains: podglądy gałęzi i poczta mają własne zasady.
/*
  Strict-Transport-Security: max-age=31536000

# Cloudflare podaje .txt jako text/plain bez kodowania, a w llms.txt są
# polskie znaki – przeglądarka zgadywała i wychodziły krzaki.
/llms.txt
  Content-Type: text/plain; charset=utf-8
