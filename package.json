{
  "name": "miszczyszyn-com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "bun scripts/build-tina.mjs && astro build",
    "build:local": "tinacms build --local --skip-cloud-checks && astro build",
    "preview": "astro preview",
    "deploy": "bun run build && wrangler deploy",
    "astro": "astro",
    "lint": "biome check --write --unsafe",
    "check": "biome check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tinacms/astro": "0.7.1",
    "astro": "7.3.8",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tinacms/cli": "4.0.1",
    "@types/react": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.47.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tinacms": "3.14.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*": [
      "bun biome check --write --unsafe --staged --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
